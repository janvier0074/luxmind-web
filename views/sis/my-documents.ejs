<%- include('partials/head', {
  title: 'Document Requests',
  heading: 'Document Requests',
  subtitle: 'Request official documents from the registrar.'
}) %>

<!-- ============ NEW REQUEST CARD ============ -->
<div class="doc-card doc-new-card">
  <div class="doc-card-head">
    <span class="doc-card-icon">📄</span>
    <div>
      <h3>Request a New Document</h3>
      <p>Fill the form below. The registrar will review and notify you when ready.</p>
    </div>
  </div>

  <form method="POST" action="/sis/my/documents/request" class="doc-form">
    <div class="doc-field">
      <label class="doc-lbl">Document Type *</label>
      <select name="document_type" class="doc-select" required>
        <option value="">— Choose a document —</option>
        <% docTypes.forEach(d => { %>
          <option value="<%= d.value %>"><%= d.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="doc-field">
      <label class="doc-lbl">Reason / Purpose</label>
      <textarea name="reason" class="doc-textarea" rows="3"
        placeholder="e.g. Needed for university application, visa, employment, etc."></textarea>
    </div>

    <button type="submit" class="doc-submit">📨 Submit Request</button>
  </form>
</div>

<!-- ============ EXISTING REQUESTS ============ -->
<h3 class="doc-sec-title">
  My Requests
  <% if (requests.length > 0) { %>
    <span class="doc-sec-count"><%= requests.length %></span>
  <% } %>
</h3>

<% if (requests.length === 0) { %>
  <div class="sis-empty" style="padding:2rem;">
    No document requests yet. Submit one above.
  </div>
<% } else { %>
  <div class="doc-list">
    <% requests.forEach(r => { %>
      <div class="doc-item doc-item-<%= r.status %>">
        <div class="doc-item-left">
          <div class="doc-item-doc">
            <span class="doc-item-doc-icon">
              <% if (r.document_type.includes('Transcript')) { %>🎓
              <% } else if (r.document_type.includes('ID Card')) { %>🪪
              <% } else if (r.document_type.includes('Recommendation')) { %>✉️
              <% } else if (r.document_type.includes('Attendance')) { %>📊
              <% } else if (r.document_type.includes('Graduation')) { %>🏆
              <% } else { %>📄<% } %>
            </span>
            <div>
              <div class="doc-item-title"><%= r.document_type %></div>
              <% if (r.reason) { %>
                <div class="doc-item-reason"><%= r.reason %></div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="doc-item-right">
          <div class="doc-item-date">
            <%= new Date(r.requested_at).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) %>
          </div>

          <div class="doc-item-badge doc-badge-<%= r.status %>">
            <% if (r.status === 'pending') { %>⏳ Pending
            <% } else if (r.status === 'ready') { %>✅ Ready
            <% } else { %>❌ Rejected<% } %>
          </div>

          <% if (r.status === 'pending') { %>
            <form method="POST" action="/sis/my/documents/cancel/<%= r.id %>" style="display:inline;"
              onsubmit="return confirm('Cancel this request?');">
              <button class="doc-cancel" type="submit">Cancel</button>
            </form>
          <% } %>
        </div>

        <% if (r.status === 'ready' && r.admin_notes) { %>
          <div class="doc-item-note doc-item-note-ready">
            ✅ <strong>Registrar:</strong> <%= r.admin_notes %>
          </div>
        <% } %>
        <% if (r.status === 'rejected' && r.admin_notes) { %>
          <div class="doc-item-note doc-item-note-rejected">
            ❌ <strong>Registrar:</strong> <%= r.admin_notes %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } %>

<style>
  /* ============ NEW REQUEST ============ */
  .doc-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
    margin-bottom: 1.75rem;
  }
  .doc-new-card {
    background: linear-gradient(180deg, #f0f9ff 0%, #fff 60%);
    border-color: #bae6fd;
  }
  .doc-card-head {
    display: flex; align-items: flex-start; gap: .85rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .doc-card-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
  }
  .doc-card-head h3 {
    font-size: 1.05rem; font-weight: 800;
    color: #0f172a; margin-bottom: .2rem;
  }
  .doc-card-head p {
    font-size: .82rem; color: #64748b;
    line-height: 1.5;
  }

  .doc-form { display: flex; flex-direction: column; gap: 1rem; }
  .doc-field { display: flex; flex-direction: column; }
  .doc-lbl {
    font-size: .72rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: .1em;
    color: #475569; margin-bottom: .4rem;
  }
  .doc-select, .doc-textarea {
    width: 100%; padding: .75rem .9rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    background: #fff; font-size: .9rem;
    font-family: inherit; color: #0f172a;
    transition: all .15s;
  }
  .doc-select:focus, .doc-textarea:focus {
    outline: none; border-color: #06b6d4;
    box-shadow: 0 0 0 3px rgba(6,182,212,.15);
  }
  .doc-textarea { resize: vertical; min-height: 70px; }

  .doc-submit {
    align-self: flex-start;
    padding: .8rem 1.5rem;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: #fff; border: none; border-radius: 10px;
    font-size: .9rem; font-weight: 800;
    cursor: pointer; font-family: inherit;
    box-shadow: 0 6px 16px rgba(6,182,212,.3);
    transition: all .15s;
  }
  .doc-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(6,182,212,.4); }

  /* ============ LIST ============ */
  .doc-sec-title {
    display: flex; align-items: center; gap: .5rem;
    font-size: .75rem; text-transform: uppercase;
    letter-spacing: .15em; color: #64748b;
    font-weight: 800; margin-bottom: 1rem;
  }
  .doc-sec-count {
    background: #0f2942; color: #67e8f9;
    font-size: .68rem; padding: 2px 8px;
    border-radius: 100px; letter-spacing: 0;
  }

  .doc-list { display: flex; flex-direction: column; gap: .75rem; }

  .doc-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #e2e8f0;
    border-radius: 12px;
    align-items: center;
    transition: all .15s;
  }
  .doc-item:hover { box-shadow: 0 4px 14px rgba(15,23,42,.06); }
  .doc-item-pending  { border-left-color: #f59e0b; }
  .doc-item-ready    { border-left-color: #10b981; }
  .doc-item-rejected { border-left-color: #ef4444; }

  .doc-item-left { min-width: 0; }
  .doc-item-doc { display: flex; align-items: flex-start; gap: .75rem; }
  .doc-item-doc-icon {
    font-size: 1.5rem; flex-shrink: 0; line-height: 1;
  }
  .doc-item-title {
    font-weight: 800; color: #0f172a; font-size: .95rem;
    word-break: break-word;
  }
  .doc-item-reason {
    color: #64748b; font-size: .82rem;
    margin-top: .2rem; line-height: 1.4;
    word-break: break-word;
  }

  .doc-item-right {
    display: flex; flex-direction: column;
    align-items: flex-end; gap: .4rem;
    flex-shrink: 0;
  }
  .doc-item-date {
    font-size: .72rem; color: #94a3b8;
    font-family: ui-monospace, monospace;
    font-weight: 700;
  }
  .doc-item-badge {
    display: inline-block;
    padding: 3px 10px;
    font-size: .7rem; font-weight: 800;
    border-radius: 100px;
    letter-spacing: .04em;
  }
  .doc-badge-pending  { background: #fef3c7; color: #92400e; }
  .doc-badge-ready    { background: #d1fae5; color: #065f46; }
  .doc-badge-rejected { background: #fee2e2; color: #991b1b; }

  .doc-cancel {
    background: #fff; color: #991b1b;
    border: 1px solid #fecaca;
    padding: .3rem .75rem;
    border-radius: 6px; font-size: .72rem;
    font-weight: 700; cursor: pointer; font-family: inherit;
    transition: all .15s;
  }
  .doc-cancel:hover { background: #fee2e2; }

  .doc-item-note {
    grid-column: 1 / -1;
    padding: .75rem .9rem;
    border-radius: 8px;
    font-size: .82rem;
    line-height: 1.5;
    margin-top: .25rem;
  }
  .doc-item-note-ready    { background: #d1fae5; color: #065f46; }
  .doc-item-note-rejected { background: #fee2e2; color: #991b1b; }

  /* ============ MOBILE ============ */
  @media (max-width: 700px) {
    .doc-card { padding: 1.15rem; }
    .doc-card-head { gap: .6rem; }
    .doc-card-icon { font-size: 1.4rem; }
    .doc-card-head h3 { font-size: .95rem; }

    .doc-submit { align-self: stretch; text-align: center; }

    .doc-item {
      grid-template-columns: 1fr;
      padding: .9rem 1rem;
      gap: .75rem;
    }
    .doc-item-right {
      flex-direction: row; align-items: center;
      justify-content: space-between;
      width: 100%;
      flex-wrap: wrap;
      gap: .5rem;
    }
    .doc-item-date { font-size: .68rem; }
  }
</style>

<%- include('partials/foot') %>