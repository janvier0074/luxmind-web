<%- include('partials/head', {
  title: 'My Timetable',
  heading: 'Timetable',
  subtitle: 'Your courses, instructors and quick links.'
}) %>

<!-- Top bar -->
<div class="tt-topbar">
  <a class="tt-back" href="/sis/my">← Back</a>
  <div class="tt-toggle">
    <button type="button" class="tt-toggle-btn active" id="btnList">List</button>
    <button type="button" class="tt-toggle-btn" id="btnCalendar">Calendar</button>
  </div>
</div>

<!-- Notice -->
<div class="tt-notice">
  <span class="tt-notice-icon">ⓘ</span>
  Students with attendance below the required threshold may not be eligible to take the final exam. Please check your Attendance Detail regularly.
</div>

<!-- =================== LIST VIEW =================== -->
<div id="viewList">
  <% if (courses.length === 0) { %>
    <div class="sis-empty" style="padding:2rem;">You haven't enrolled in any course yet.</div>
  <% } else { %>
    <div class="tt-list-wrap">
      <table class="tt-list">
        <colgroup>
          <col style="width: 100px;">
          <col>
          <col style="width: 180px;">
          <col style="width: 70px;">
          <col style="width: 110px;">
          <col style="width: 110px;">
        </colgroup>
        <thead>
          <tr>
            <th>Course Code</th>
            <th>Course Name</th>
            <th>Course Instructor</th>
            <th class="c">Group</th>
            <th class="c">Attendance</th>
            <th class="c">Moodle</th>
          </tr>
        </thead>
        <tbody>
          <% courses.forEach((c) => {
            const code = 'LXM' + String(100 + (c.id % 900)).padStart(4, '0');
            const group = 'GR' + String((c.id % 5) + 1).padStart(2, '0');
            const pct = c.total_lessons > 0 ? Math.round((c.done_lessons / c.total_lessons) * 100) : 0;
            const attColor = pct >= 75 ? '#10b981' : (pct >= 50 ? '#f59e0b' : '#ef4444');
            const lmsUrl = 'https://luxmind.onrender.com/login?next=' + encodeURIComponent('/courses/' + c.id);
          %>
            <tr>
              <td><span class="tt-code"><%= code %></span></td>
              <td><span class="tt-name"><%= c.title %></span></td>
                            <td>
                <%
                  const instrList = teachersByCourse[c.id] || [];
                  if (instrList.length === 0 && c.teacher_name) {
                    // Fallback for courses not in course_teachers
                %>
                  <span class="tt-instr"><%= c.teacher_name %></span>
                <% } else if (instrList.length === 0) { %>
                  <span class="tt-instr">LuxMind</span>
                <% } else { %>
                  <div class="tt-instr-list">
                    <% instrList.forEach((t, idx) => { %>
                      <div class="tt-instr-row">
                        <span class="tt-instr-dot <%= t.role === 'instructor' ? 'primary' : (t.role === 'co-instructor' ? 'co' : 'assistant') %>"></span>
                        <span class="tt-instr"><%= t.full_name || t.username %></span>
                        <% if (t.role !== 'instructor') { %>
                          <span class="tt-instr-role"><%= t.role.replace('-', ' ') %></span>
                        <% } %>
                        <% if (t.section) { %>
                          <span class="tt-instr-section"><%= t.section %></span>
                        <% } %>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </td>
              <td class="c"><span class="tt-group"><%= group %></span></td>
              <td class="c">
                <a href="/sis/my/attendance" class="tt-att" style="color:<%= attColor %>;background:<%= attColor %>15;border-color:<%= attColor %>40;">
                  <%= pct %>%
                </a>
              </td>
              <td class="c">
                <a class="tt-moodle" href="<%= lmsUrl %>" title="Open in Moodle">
                  <span class="tt-moodle-dot"></span> Moodle
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- =================== CALENDAR VIEW =================== -->
<div id="viewCalendar" style="display:none;">
  <% if (courses.length === 0) { %>
    <div class="sis-empty" style="padding:2rem;">Nothing scheduled.</div>
  <% } else { %>
    <%
      const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      const SLOTS = ['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00'];
      const grid = {};
      DAYS.forEach(d => { grid[d] = {}; SLOTS.forEach(s => grid[d][s] = []); });
      courses.forEach(c => {
        const day = DAYS[c.id % 6];
        const slot = SLOTS[(c.id * 3) % 9];
        const code = 'LXM' + String(100 + (c.id % 900)).padStart(4, '0');
        const group = 'GR' + String((c.id % 5) + 1).padStart(2, '0');
        grid[day][slot].push({ code, group, title: c.title, id: c.id });
      });
    %>
    <div class="tt-cal-wrap">
      <table class="tt-cal">
        <thead>
          <tr>
            <th class="tt-cal-time-col"></th>
            <% DAYS.forEach(d => { %><th><%= d %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% SLOTS.forEach(slot => { %>
            <tr>
              <td class="tt-cal-time"><%= slot %></td>
              <% DAYS.forEach(day => { const items = grid[day][slot]; %>
                <td class="tt-cal-cell">
                  <% items.forEach(it => { %>
                    <a class="tt-cal-event" href="https://luxmind.onrender.com/login?next=<%= encodeURIComponent('/courses/' + it.id) %>" title="<%= it.title %>">
                      <span class="tt-cal-code"><%= it.code %> · <%= it.group %></span>
                      <span class="tt-cal-name"><%= it.title %></span>
                    </a>
                  <% }) %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<style>
  /* ============ TOP BAR ============ */
  .tt-topbar {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1rem; gap: 1rem; flex-wrap: wrap;
  }
  .tt-back {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .5rem 1rem;
    background: #fff; color: #0f2942;
    border: 1px solid #e2e8f0; border-radius: 8px;
    font-size: .82rem; font-weight: 700; text-decoration: none;
    transition: all .15s;
  }
  .tt-back:hover { background: #f8fafc; border-color: #06b6d4; color: #0891b2; }

  .tt-toggle {
    display: inline-flex; background: #fff;
    border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;
  }
  .tt-toggle-btn {
    background: transparent; border: none;
    padding: .5rem 1.1rem; font-size: .78rem; font-weight: 700;
    color: #64748b; cursor: pointer; font-family: inherit;
    transition: all .15s;
  }
  .tt-toggle-btn.active {
    background: linear-gradient(135deg, #06b6d4, #0891b2); color: #fff;
  }

  /* ============ NOTICE ============ */
  .tt-notice {
    display: flex; align-items: flex-start; gap: .6rem;
    background: #f0f9ff; border-left: 3px solid #06b6d4;
    padding: .75rem 1rem; border-radius: 8px;
    color: #0c4a6e; font-size: .82rem;
    margin-bottom: 1.25rem; line-height: 1.55;
  }
  .tt-notice-icon { font-size: 1rem; color: #0891b2; flex-shrink: 0; }

  /* ============ LIST TABLE ============ */
  .tt-list-wrap {
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 12px; overflow: hidden;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
  }
  .tt-list {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .tt-list thead {
    background: #f8fafc;
  }
  .tt-list th {
    text-align: left;
    padding: .7rem .9rem;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #64748b;
    border-bottom: 2px solid #e2e8f0;
    white-space: nowrap;
  }
  .tt-list th.c { text-align: center; }
  .tt-list td {
    padding: .75rem .9rem;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
    font-size: .85rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tt-list td.c { text-align: center; }
  .tt-list tbody tr:last-child td { border-bottom: none; }
  .tt-list tbody tr:hover { background: #f8fafc; }

  .tt-code {
    font-family: ui-monospace, monospace;
    font-weight: 800;
    color: #0891b2;
    font-size: .8rem;
    letter-spacing: -.01em;
  }
  .tt-name {
    font-weight: 700;
    color: #0f172a;
    font-size: .88rem;
  }
  .tt-instr {
    color: #475569;
    font-size: .82rem;
  }
  .tt-instr-list { display: flex; flex-direction: column; gap: .25rem; }
  .tt-instr-row { display: flex; align-items: center; gap: .4rem; font-size: .82rem; }
  .tt-instr-dot {
    width: 6px; height: 6px; border-radius: 50%;
    flex-shrink: 0;
  }
  .tt-instr-dot.primary { background: #0891b2; }
  .tt-instr-dot.co { background: #f59e0b; }
  .tt-instr-dot.assistant { background: #94a3b8; }
  .tt-instr-role {
    font-size: .65rem; text-transform: uppercase;
    letter-spacing: .08em; color: #94a3b8;
    font-weight: 800;
    background: #f1f5f9;
    padding: 1px 6px; border-radius: 4px;
  }
  .tt-instr-section {
    font-size: .65rem; font-family: ui-monospace, monospace;
    color: #475569; font-weight: 700;
  }
  .tt-group {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: .72rem;
    font-weight: 700;
    color: #475569;
    background: #f1f5f9;
    padding: 2px 7px;
    border-radius: 4px;
  }
  .tt-att {
    display: inline-block;
    padding: .28rem .55rem;
    border-radius: 6px;
    border: 1px solid;
    font-size: .76rem;
    font-weight: 800;
    text-decoration: none;
    font-family: ui-monospace, monospace;
    min-width: 44px;
  }
  .tt-moodle {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .35rem .75rem;
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff !important;
    border-radius: 6px;
    font-size: .76rem;
    font-weight: 800;
    text-decoration: none;
    transition: all .15s;
  }
  .tt-moodle:hover { transform: translateY(-1px); box-shadow: 0 4px 10px rgba(16,185,129,.35); }
  .tt-moodle-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #fff; opacity: .85;
  }

  /* ============ CALENDAR ============ */
  .tt-cal-wrap {
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 12px; overflow-x: auto;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
  }
  .tt-cal {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
    table-layout: fixed;
  }
  .tt-cal thead th {
    background: #0f2942;
    color: #fff;
    padding: .55rem .4rem;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.08);
  }
  .tt-cal thead th:last-child { border-right: none; }
  .tt-cal-time-col { width: 60px; }
  .tt-cal tbody td {
    border: 1px solid #e2e8f0;
    padding: 2px;
    height: 34px;
    vertical-align: top;
  }
  .tt-cal-time {
    background: #f8fafc;
    color: #475569;
    font-family: ui-monospace, monospace;
    font-size: .68rem;
    font-weight: 700;
    text-align: center;
    vertical-align: middle !important;
    white-space: nowrap;
  }
  .tt-cal-cell { background: #fff; }
  .tt-cal-event {
    display: block;
    padding: .2rem .4rem;
    background: linear-gradient(135deg, #0891b2, #0e7490);
    color: #fff !important;
    border-radius: 4px;
    text-decoration: none;
    font-size: .65rem;
    line-height: 1.2;
    font-weight: 600;
    margin-bottom: 2px;
    overflow: hidden;
    transition: all .12s;
  }
  .tt-cal-event:last-child { margin-bottom: 0; }
  .tt-cal-event:hover { background: linear-gradient(135deg, #06b6d4, #0891b2); }
  .tt-cal-code {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: .58rem;
    font-weight: 800;
    opacity: .85;
    letter-spacing: -.02em;
  }
  .tt-cal-name {
    display: block;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ============ MOBILE ============ */
  @media (max-width: 700px) {
    .tt-topbar { flex-direction: column; align-items: stretch; gap: .75rem; }
    .tt-back { justify-content: center; }
    .tt-toggle { width: 100%; }
    .tt-toggle-btn { flex: 1; }

    .tt-notice { font-size: .75rem; padding: .65rem .8rem; }

    /* List table on mobile becomes compact — horizontal scroll */
    .tt-list-wrap { overflow-x: auto; }
    .tt-list { min-width: 700px; }

    .tt-cal { min-width: 640px; }
    .tt-cal tbody td { height: 28px; }
    .tt-cal-event { font-size: .58rem; padding: .15rem .3rem; }
    .tt-cal-code { font-size: .52rem; }
  }
</style>

<script>
  (function () {
    var btnList = document.getElementById('btnList');
    var btnCal = document.getElementById('btnCalendar');
    var viewList = document.getElementById('viewList');
    var viewCal = document.getElementById('viewCalendar');
    if (!btnList || !btnCal) return;
    btnList.addEventListener('click', function () {
      viewList.style.display = 'block';
      viewCal.style.display = 'none';
      btnList.classList.add('active');
      btnCal.classList.remove('active');
    });
    btnCal.addEventListener('click', function () {
      viewList.style.display = 'none';
      viewCal.style.display = 'block';
      btnCal.classList.add('active');
      btnList.classList.remove('active');
    });
  })();
</script>

<%- include('partials/foot') %>