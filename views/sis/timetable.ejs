<%- include('partials/head', {
  title: 'My Timetable',
  heading: 'Timetable',
  subtitle: 'Your courses, instructors and quick links.'
}) %>

<div style="margin-bottom:1.5rem;">
  <a class="sis-btn sis-btn-outline" href="/sis/my">← Back to Overview</a>
</div>

<div class="sis-card" style="padding:0;overflow:hidden;">
  <table class="sis-table">
    <thead>
      <tr>
        <th style="width:90px;">Code</th>
        <th>Course Name</th>
        <th>Instructor</th>
        <th style="width:90px;text-align:center;">Syllabus</th>
        <th style="width:110px;text-align:center;">Attendance</th>
        <th style="width:100px;text-align:center;">Moodle</th>
      </tr>
    </thead>
    <tbody>
      <% if (courses.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align:center;padding:2.5rem;color:#64748b;">
            You haven't enrolled in any course yet.
            <a href="https://luxmind.onrender.com/explore" style="color:#0891b2;font-weight:700;"> Browse courses →</a>
          </td>
        </tr>
      <% } else { %>
        <% courses.forEach((c, i) => {
          const code = 'LXM' + String(100 + (c.id % 900)).padStart(4, '0');
          const pct = c.total_lessons > 0 ? Math.round((c.done_lessons / c.total_lessons) * 100) : 0;
          const attColor = pct >= 75 ? '#10b981' : (pct >= 50 ? '#f59e0b' : '#ef4444');
          const lmsUrl = 'https://luxmind.onrender.com/courses/' + c.id;
        %>
          <tr>
            <td>
              <a href="<%= lmsUrl %>" style="text-decoration:none;font-family:ui-monospace,monospace;font-weight:800;color:#0891b2;font-size:.85rem;" title="Open in LMS">
                <%= code %>
              </a>
            </td>
            <td>
              <a href="<%= lmsUrl %>" style="text-decoration:none;color:inherit;display:block;" title="Open in LMS">
                <div style="font-weight:700;color:#0f172a;"><%= c.title %> <span style="font-size:.75rem;color:#0891b2;font-weight:600;">↗</span></div>
                <% if (c.description) { %>
                  <div style="color:#64748b;font-size:.8rem;margin-top:.2rem;"><%= c.description.slice(0, 80) %><%= c.description.length > 80 ? '…' : '' %></div>
                <% } %>
              </a>
            </td>
            <td style="color:#334155;font-size:.88rem;"><%= c.teacher_name || 'LuxMind' %></td>
            <td style="text-align:center;">
              <a href="<%= lmsUrl %>" title="Syllabus & lessons" style="display:inline-flex;width:32px;height:32px;background:#e0f2fe;color:#0369a1;border-radius:6px;align-items:center;justify-content:center;text-decoration:none;font-size:.95rem;">📘</a>
            </td>
            <td style="text-align:center;">
              <a href="/sis/my/attendance" title="My attendance" style="display:inline-flex;text-decoration:none;">
                <span style="display:inline-flex;width:36px;height:32px;background:<%= attColor %>22;color:<%= attColor %>;border-radius:6px;align-items:center;justify-content:center;font-size:.78rem;font-weight:800;"><%= pct %>%</span>
              </a>
            </td>
            <td style="text-align:center;">
              <a class="sis-moodle-btn" href="<%= lmsUrl %>" title="Open in LuxMind LMS">
                🟢 Open
              </a>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<div class="sis-card">
  <h3>📅 Upcoming Deadlines</h3>
  <% if (deadlines.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">Nothing due soon. Enjoy the break ✨</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Type</th>
          <th>Title</th>
          <th>Course</th>
          <th style="text-align:right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% deadlines.forEach(d => {
          const when = new Date(d.event_at);
          const hours = (when - new Date()) / 3600000;
          const urgent = hours < 24 ? 'sis-badge-inactive' : (hours < 72 ? 'sis-badge-gold' : 'sis-badge-active');
        %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;">
              <%= when.toLocaleDateString('en-GB', { weekday:'short', day:'2-digit', month:'short' }) %>
              <span style="color:#64748b;"><%= when.toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }) %></span>
            </td>
            <td><span class="sis-badge <%= urgent %>"><%= d.kind === 'quiz' ? 'Quiz' : 'Assignment' %></span></td>
            <td><strong><%= d.title %></strong></td>
            <td style="color:#64748b;"><%= d.course %></td>
            <td style="text-align:right;">
              <a class="sis-btn sis-btn-outline" style="padding:.35rem .8rem;font-size:.78rem;"
                href="https://luxmind.onrender.com<%= d.kind === 'assignment' ? '/student/assignments/' + d.id : '/student/quiz/' + d.id %>">
                Open →
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>