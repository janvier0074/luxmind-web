<%- include('partials/head', {
  title: 'My Timetable',
  heading: 'Timetable',
  subtitle: 'Your courses, instructors and quick links.'
}) %>

<div class="tt-topbar">
  <a class="sis-btn sis-btn-outline" href="/sis/my">← Back</a>
  <div class="tt-toggle">
    <button type="button" class="tt-toggle-btn active" id="btnList">List</button>
    <button type="button" class="tt-toggle-btn" id="btnCalendar">Calendar</button>
  </div>
</div>

<div class="tt-notice">
  ⓘ Students with attendance below the required threshold may not be eligible to take the final exam. Check your Attendance Detail regularly.
</div>

<!-- =================== LIST VIEW =================== -->
<div id="viewList">
  <% if (courses.length === 0) { %>
    <div class="sis-empty" style="padding:2rem;">You haven't enrolled in any course yet.</div>
  <% } else { %>
    <div class="sis-card" style="padding:0;overflow:hidden;">
      <table class="sis-table tt-list-table">
        <thead>
          <tr>
            <th style="width:100px;">Code</th>
            <th>Course Name</th>
            <th style="width:160px;">Instructor</th>
            <th style="width:70px;text-align:center;">Group</th>
            <th style="width:110px;text-align:center;">Attendance</th>
            <th style="width:100px;text-align:center;">Moodle</th>
          </tr>
        </thead>
        <tbody>
          <% courses.forEach((c) => {
            const code = 'LXM' + String(100 + (c.id % 900)).padStart(4, '0');
            const group = 'GR' + String((c.id % 5) + 1).padStart(2, '0');
            const pct = c.total_lessons > 0 ? Math.round((c.done_lessons / c.total_lessons) * 100) : 0;
            const attColor = pct >= 75 ? '#10b981' : (pct >= 50 ? '#f59e0b' : '#ef4444');
            const lmsUrl = 'https://luxmind.onrender.com/login?next=' + encodeURIComponent('/courses/' + c.id);
          %>
            <tr>
              <td style="font-family:ui-monospace,monospace;font-weight:800;color:#0891b2;font-size:.8rem;"><%= code %></td>
              <td><strong style="font-size:.88rem;"><%= c.title %></strong></td>
              <td style="color:#334155;font-size:.82rem;"><%= c.teacher_name || 'LuxMind' %></td>
              <td style="text-align:center;font-family:ui-monospace,monospace;font-size:.78rem;color:#475569;"><%= group %></td>
              <td style="text-align:center;">
                <a href="/sis/my/attendance" style="display:inline-flex;width:46px;height:26px;background:<%= attColor %>22;color:<%= attColor %>;border-radius:6px;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;text-decoration:none;">
                  <%= pct %>%
                </a>
              </td>
              <td style="text-align:center;">
                <a class="sis-moodle-btn" href="<%= lmsUrl %>" title="Open in Moodle">Moodle</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- =================== CALENDAR VIEW =================== -->
<div id="viewCalendar" style="display:none;">
  <% if (courses.length === 0) { %>
    <div class="sis-empty" style="padding:2rem;">Nothing scheduled.</div>
  <% } else { %>
    <%
      const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      const SLOTS = ['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00'];
      const grid = {};
      DAYS.forEach(d => { grid[d] = {}; SLOTS.forEach(s => grid[d][s] = []); });
      courses.forEach(c => {
        const day = DAYS[c.id % 6];
        const slot = SLOTS[(c.id * 3) % 9];
        const code = 'LXM' + String(100 + (c.id % 900)).padStart(4, '0');
        const group = 'GR' + String((c.id % 5) + 1).padStart(2, '0');
        grid[day][slot].push({ code, group, title: c.title, id: c.id });
      });
    %>
    <div class="tt-cal-wrap">
      <table class="tt-cal">
        <thead>
          <tr>
            <th class="tt-cal-time-col"></th>
            <% DAYS.forEach(d => { %><th><%= d %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% SLOTS.forEach(slot => { %>
            <tr>
              <td class="tt-cal-time"><%= slot %></td>
              <% DAYS.forEach(day => { const items = grid[day][slot]; %>
                <td class="tt-cal-cell">
                  <% items.forEach(it => { %>
                    <a class="tt-cal-event" href="https://luxmind.onrender.com/login?next=<%= encodeURIComponent('/courses/' + it.id) %>" title="<%= it.title %>">
                      <span class="tt-cal-code"><%= it.code %> · <%= it.group %></span>
                      <span class="tt-cal-name"><%= it.title %></span>
                    </a>
                  <% }) %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<style>
  .tt-topbar {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1rem; gap: 1rem; flex-wrap: wrap;
  }
  .tt-toggle {
    display: inline-flex; background: #fff;
    border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden;
  }
  .tt-toggle-btn {
    background: transparent; border: none;
    padding: .45rem .9rem; font-size: .78rem; font-weight: 700;
    color: #64748b; cursor: pointer; font-family: inherit; transition: all .15s;
  }
  .tt-toggle-btn.active {
    background: linear-gradient(135deg, #06b6d4, #0891b2); color: #fff;
  }

  .tt-notice {
    background: #f0f9ff; border-left: 3px solid #06b6d4;
    padding: .7rem .9rem; border-radius: 6px;
    color: #0c4a6e; font-size: .78rem;
    margin-bottom: 1rem; line-height: 1.5;
  }

  /* Compact list table */
  .tt-list-table th {
    padding: .55rem .75rem !important;
    font-size: .65rem !important;
    letter-spacing: .08em;
  }
  .tt-list-table td {
    padding: .55rem .75rem !important;
    font-size: .85rem;
    vertical-align: middle;
  }

  /* Compact calendar grid */
  .tt-cal-wrap {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
    overflow-x: auto; box-shadow: 0 1px 3px rgba(15,23,42,.04);
  }
  .tt-cal { width: 100%; border-collapse: collapse; min-width: 780px; }
  .tt-cal thead th {
    background: #0f2942; color: #fff;
    padding: .5rem .35rem;
    font-size: .68rem; font-weight: 800;
    letter-spacing: .06em; text-transform: uppercase; text-align: center;
  }
  .tt-cal-time-col { width: 58px; }
  .tt-cal tbody td {
    border: 1px solid #e2e8f0; padding: 2px;
    height: 32px; vertical-align: top;
  }
  .tt-cal-time {
    background: #f8fafc; color: #475569;
    font-family: ui-monospace, monospace;
    font-size: .68rem; font-weight: 700;
    text-align: center; vertical-align: middle !important; white-space: nowrap;
  }
  .tt-cal-cell { background: #fff; }
  .tt-cal-event {
    display: block; padding: .2rem .4rem;
    background: linear-gradient(135deg, #0891b2, #0e7490);
    color: #fff; border-radius: 4px; text-decoration: none;
    font-size: .65rem; line-height: 1.15; font-weight: 600;
    overflow: hidden;
  }
  .tt-cal-event:hover { background: linear-gradient(135deg, #06b6d4, #0891b2); }
  .tt-cal-code {
    display: block; font-family: ui-monospace, monospace;
    font-size: .58rem; font-weight: 800; opacity: .85;
  }
  .tt-cal-name {
    display: block; font-weight: 700;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  @media (max-width: 700px) {
    .tt-topbar { flex-direction: column; align-items: stretch; }
    .tt-toggle { width: 100%; }
    .tt-toggle-btn { flex: 1; }
    .tt-cal { min-width: 640px; }
    .tt-cal tbody td { height: 26px; }
    .tt-cal-event { font-size: .58rem; padding: .15rem .3rem; }
    .tt-notice { font-size: .72rem; padding: .6rem .75rem; }
  }
</style>

<script>
  (function () {
    var btnList = document.getElementById('btnList');
    var btnCal = document.getElementById('btnCalendar');
    var viewList = document.getElementById('viewList');
    var viewCal = document.getElementById('viewCalendar');
    if (!btnList || !btnCal) return;
    btnList.addEventListener('click', function () {
      viewList.style.display = 'block';
      viewCal.style.display = 'none';
      btnList.classList.add('active');
      btnCal.classList.remove('active');
    });
    btnCal.addEventListener('click', function () {
      viewList.style.display = 'none';
      viewCal.style.display = 'block';
      btnCal.classList.add('active');
      btnList.classList.remove('active');
    });
  })();
</script>

<%- include('partials/foot') %>