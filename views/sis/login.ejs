<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in · LuxMind SIS</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', -apple-system, system-ui, sans-serif; }
  html, body { height: 100%; overflow: hidden; }

  .sis-login-shell {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    background: #f1f5f9;
  }

  /* LEFT — navy/cyan brand panel */
  .sis-brand-panel {
    background: linear-gradient(160deg, #0f2942 0%, #0891b2 100%);
    color: #fff;
    padding: 3.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .sis-brand-panel::before {
    content: '';
    position: absolute;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(6,182,212,.4) 0%, transparent 70%);
    top: -100px; right: -100px;
    pointer-events: none;
  }
  .sis-brand-panel::after {
    content: '';
    position: absolute;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(8,145,178,.3) 0%, transparent 70%);
    bottom: -150px; left: -150px;
    pointer-events: none;
  }
  .sis-brand-logo-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }
  .sis-brand-logo {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 1.4rem; color: #051b30;
    box-shadow: 0 8px 24px rgba(6,182,212,.5);
  }
  .sis-brand-text { line-height: 1.15; }
  .sis-brand-title { font-weight: 900; font-size: 1.3rem; letter-spacing: -.01em; color: #fff; }
  .sis-brand-sub { font-size: .72rem; text-transform: uppercase; letter-spacing: .2em; color: #67e8f9; font-weight: 800; margin-top: 4px; }

  .sis-brand-hero { position: relative; z-index: 2; }
  .sis-brand-hero h1 {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 900;
    letter-spacing: -.03em;
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }
  .sis-brand-hero h1 span {
    background: linear-gradient(135deg, #67e8f9, #22d3ee);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .sis-brand-hero p {
    font-size: 1rem;
    line-height: 1.6;
    opacity: .85;
    max-width: 380px;
  }

  .sis-brand-footer {
    display: flex;
    justify-content: space-between;
    font-size: .8rem;
    opacity: .7;
    position: relative;
    z-index: 2;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,.12);
  }
  .sis-brand-stat-num { font-weight: 800; font-size: 1.1rem; }
  .sis-brand-stat-lbl { font-size: .68rem; text-transform: uppercase; letter-spacing: .12em; opacity: .7; margin-top: 2px; }

  /* RIGHT — login form */
  .sis-form-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    background: #fff;
  }
  .sis-form-container { width: 100%; max-width: 400px; }
  .sis-form-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: #0f2942;
    letter-spacing: -.02em;
    margin-bottom: .5rem;
  }
  .sis-form-sub {
    color: #64748b;
    font-size: .95rem;
    margin-bottom: 2rem;
    line-height: 1.5;
  }
  .sis-field { margin-bottom: 1.15rem; }
  .sis-field label {
    display: block;
    font-size: .82rem;
    font-weight: 700;
    color: #334155;
    margin-bottom: .4rem;
    letter-spacing: .02em;
  }
  .sis-field input {
    width: 100%;
    padding: .9rem 1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    font-size: .95rem;
    background: #f8fafc;
    font-family: inherit;
    transition: all .15s;
  }
  .sis-field input:focus {
    outline: none;
    border-color: #06b6d4;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(6,182,212,.12);
  }
  .sis-submit-btn {
    width: 100%;
    padding: 1rem;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: .02em;
    box-shadow: 0 10px 24px rgba(6,182,212,.35);
    transition: all .15s;
    font-family: inherit;
  }
  .sis-submit-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(6,182,212,.45); }
  .sis-submit-btn:disabled { opacity: .6; cursor: not-allowed; transform: none; }

  .sis-err-box {
    background: #fee2e2;
    color: #991b1b;
    padding: .9rem 1rem;
    border-radius: 10px;
    font-size: .88rem;
    margin-bottom: 1.25rem;
    display: none;
    border-left: 4px solid #ef4444;
  }
  .sis-err-box.show { display: block; }

  .sis-form-footer {
    margin-top: 2rem;
    text-align: center;
    color: #64748b;
    font-size: .88rem;
    padding-top: 1.5rem;
    border-top: 1px solid #f1f5f9;
  }
  .sis-form-footer a { color: #0891b2; font-weight: 700; text-decoration: none; }
  .sis-form-footer a:hover { text-decoration: underline; }

  .sis-lms-link {
    display: block;
    margin-top: 1rem;
    text-align: center;
    color: #94a3b8;
    font-size: .82rem;
    text-decoration: none;
  }
  .sis-lms-link:hover { color: #0891b2; }

  @media (max-width: 900px) {
    .sis-login-shell { grid-template-columns: 1fr; }
    .sis-brand-panel { display: none; }
  }
</style>
</head>
<body>

<div class="sis-login-shell">

  <div class="sis-brand-panel">
    <div class="sis-brand-logo-row">
      <div class="sis-brand-logo">S</div>
      <div class="sis-brand-text">
        <div class="sis-brand-title">LuxMind SIS</div>
        <div class="sis-brand-sub">Student Information System</div>
      </div>
    </div>

    <div class="sis-brand-hero">
      <h1>Your academic<br/>record, <span>reimagined</span>.</h1>
      <p>The official student portal for LuxMind — timetable, attendance, transcript, and fees, all in one place.</p>
    </div>

    <div class="sis-brand-footer">
      <div>
        <div class="sis-brand-stat-num">24/7</div>
        <div class="sis-brand-stat-lbl">Available</div>
      </div>
      <div>
        <div class="sis-brand-stat-num">100%</div>
        <div class="sis-brand-stat-lbl">Secure</div>
      </div>
      <div>
        <div class="sis-brand-stat-num">2026</div>
        <div class="sis-brand-stat-lbl">Academic Year</div>
      </div>
    </div>
  </div>

  <div class="sis-form-panel">
    <div class="sis-form-container">

      <h2 class="sis-form-title">Sign in</h2>
      <p class="sis-form-sub">Use your LuxMind account to access the SIS portal.</p>

      <div class="sis-err-box" id="error-box"></div>

      <form id="sisLoginForm">
        <div class="sis-field">
          <label for="email">Email address</label>
          <input type="email" id="email" placeholder="you@example.com" required autocomplete="email">
        </div>
        <div class="sis-field">
          <label for="password">Password</label>
          <input type="password" id="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="sis-submit-btn" id="submitBtn">Sign in →</button>
      </form>

      <div class="sis-form-footer">
        Need an account? <a href="/register">Create one</a>
      </div>
      <a class="sis-lms-link" href="https://luxmind.onrender.com">← Back to LuxMind LMS</a>

    </div>
  </div>

</div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
  import { getAuth, signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "<%= process.env.FIREBASE_API_KEY || '' %>",
    authDomain: "<%= process.env.FIREBASE_AUTH_DOMAIN || '' %>",
    projectId: "<%= process.env.FIREBASE_PROJECT_ID || '' %>",
    storageBucket: "<%= process.env.FIREBASE_STORAGE_BUCKET || '' %>",
    messagingSenderId: "<%= process.env.FIREBASE_MESSAGING_SENDER_ID || '' %>",
    appId: "<%= process.env.FIREBASE_APP_ID || '' %>"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);

  const form = document.getElementById('sisLoginForm');
  const submitBtn = document.getElementById('submitBtn');
  const errBox = document.getElementById('error-box');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errBox.classList.remove('show');

    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in...';

    try {
      const cred = await signInWithEmailAndPassword(auth, email, password);
      const idToken = await cred.user.getIdToken();

      const resp = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idToken })
      });

      const data = await resp.json();

      if (resp.ok && data.success) {
        window.location.href = data.redirect || '/sis';
      } else {
        throw new Error(data.error || 'Login failed');
      }
    } catch (err) {
      let msg = 'Login failed. Please try again.';
      if (err.code === 'auth/invalid-credential' || err.code === 'auth/wrong-password') msg = 'Incorrect email or password.';
      if (err.code === 'auth/user-not-found') msg = 'No account found with that email.';
      if (err.code === 'auth/too-many-requests') msg = 'Too many attempts. Try again later.';
      if (err.message && err.message.includes('not in LuxMind')) msg = err.message;

      errBox.textContent = msg;
      errBox.classList.add('show');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign in →';
    }
  });
</script>

</body>
</html>