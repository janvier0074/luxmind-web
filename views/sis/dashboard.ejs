<%- include('partials/head', {
  title: 'Overview',
  heading: 'School Overview',
  subtitle: 'A snapshot of the institution.'
}) %>

<div class="sis-stat-grid">
  <div class="sis-stat gold">
    <div class="sis-stat-num"><%= stats.students %></div>
    <div class="sis-stat-lbl">Total Students</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= stats.activeStudents %></div>
    <div class="sis-stat-lbl">Active Students</div>
  </div>
  <div class="sis-stat slate">
    <div class="sis-stat-num"><%= stats.classes %></div>
    <div class="sis-stat-lbl">Classes</div>
  </div>
  <div class="sis-stat red">
    <div class="sis-stat-num"><%= stats.teachers %></div>
    <div class="sis-stat-lbl">Teachers</div>
  </div>
</div>

<div class="sis-stat-grid">
  <div class="sis-stat gold">
    <div class="sis-stat-num"><%= stats.presentToday %></div>
    <div class="sis-stat-lbl">Present Today</div>
  </div>
  <div class="sis-stat red">
    <div class="sis-stat-num"><%= stats.absentToday %></div>
    <div class="sis-stat-lbl">Absent Today</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= Number(stats.feesThisMonth).toLocaleString() %></div>
    <div class="sis-stat-lbl">Fees This Month (BIF)</div>
  </div>
</div>

<div class="sis-card">
  <h3>Recent Students</h3>
  <% if (recentStudents.length === 0) { %>
    <div class="sis-empty">No students registered yet. <a href="/sis/students/new" style="color:#b45309;">Add the first →</a></div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Class</th>
          <th>Admission #</th>
          <th>Joined</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% recentStudents.forEach(s => { %>
          <tr>
            <td><strong><%= s.full_name || s.username %></strong></td>
            <td><%= s.class_level || '—' %></td>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;"><%= s.admission_number || '—' %></td>
            <td style="color:#78716c;font-size:.85rem;"><%= new Date(s.created_at).toLocaleDateString() %></td>
            <td style="text-align:right;">
              <a class="sis-btn sis-btn-outline" href="/sis/students/<%= s.id %>" style="padding:.4rem .8rem;font-size:.78rem;">View</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="sis-card">
  <h3>Quick Actions</h3>
  <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
    <a class="sis-btn sis-btn-gold" href="/sis/students/new">+ Register Student</a>
    <a class="sis-btn sis-btn-outline" href="/sis/students">View All Students</a>
    <a class="sis-btn sis-btn-outline" href="/sis/attendance">Take Attendance</a>
    <a class="sis-btn sis-btn-outline" href="/sis/fees">Record Payment</a>
  </div>
</div>

<%- include('partials/foot') %>