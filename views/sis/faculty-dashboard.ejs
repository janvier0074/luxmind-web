<%- include('partials/head', {
  title: 'Faculty',
  heading: 'Welcome, ' + (user.full_name || user.username),
  subtitle: 'Your classes and attendance.'
}) %>

<div class="sis-stat-grid">
  <div class="sis-stat gold">
    <div class="sis-stat-num"><%= stats.classes %></div>
    <div class="sis-stat-lbl">Classes</div>
  </div>
  <div class="sis-stat slate">
    <div class="sis-stat-num"><%= stats.students %></div>
    <div class="sis-stat-lbl">Active Students</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= stats.markedToday %></div>
    <div class="sis-stat-lbl">Marked Today</div>
  </div>
</div>

<div class="sis-card">
  <h3>Quick Actions</h3>
  <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
    <a class="sis-btn sis-btn-gold" href="/sis/attendance">📅 Take Attendance</a>
    <a class="sis-btn sis-btn-outline" href="/sis/students">View Students</a>
  </div>
</div>

<div class="sis-card">
  <h3>My Classes</h3>
  <% if (classRows.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">No classes assigned yet.</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Class</th>
          <th>Students</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% classRows.forEach(c => { %>
          <tr>
            <td><strong><%= c.name %></strong></td>
            <td><span class="sis-badge sis-badge-gold"><%= c.student_count %> students</span></td>
            <td style="text-align:right;white-space:nowrap;">
              <a class="sis-btn sis-btn-gold" href="/sis/attendance?class=<%= encodeURIComponent(c.name) %>"
                style="padding:.4rem .9rem;font-size:.78rem;">Mark Attendance</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div class="sis-card">
  <h3>Recent Attendance Activity</h3>
  <% if (recentRows.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">No attendance has been marked yet.</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Student</th>
          <th>Class</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% recentRows.forEach(r => { %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;">
              <%= new Date(r.attendance_date).toLocaleDateString('en-GB', { day:'2-digit', month:'short' }) %>
            </td>
            <td><%= r.student_name %></td>
            <td><%= r.class_level || '—' %></td>
            <td>
              <% if (r.status === 'present') { %>
                <span class="sis-badge sis-badge-active">Present</span>
              <% } else if (r.status === 'absent') { %>
                <span class="sis-badge sis-badge-inactive">Absent</span>
              <% } else if (r.status === 'late') { %>
                <span class="sis-badge sis-badge-gold">Late</span>
              <% } else { %>
                <span class="sis-badge" style="background:#e7e5e4;color:#44403c;">Excused</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>