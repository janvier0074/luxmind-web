<%- include('partials/head', {
  title: 'Attendance Detail',
  heading: 'Attendance Detail',
  subtitle: 'Your full attendance record.'
}) %>

<div style="margin-bottom:1.5rem;">
  <a class="sis-btn sis-btn-outline" href="/sis/my">← Back to Overview</a>
</div>

<div class="sis-stat-grid">
  <div class="sis-stat gold">
    <div class="sis-stat-num"><%= summary.pct %>%</div>
    <div class="sis-stat-lbl">Attendance Rate</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= summary.present || 0 %></div>
    <div class="sis-stat-lbl">Present</div>
  </div>
  <div class="sis-stat red">
    <div class="sis-stat-num"><%= summary.absent || 0 %></div>
    <div class="sis-stat-lbl">Absent</div>
  </div>
  <div class="sis-stat slate">
    <div class="sis-stat-num"><%= summary.late || 0 %></div>
    <div class="sis-stat-lbl">Late</div>
  </div>
</div>

<% if (summary.total > 0 && summary.pct < 75) { %>
  <div class="sis-flash sis-flash-error" style="margin-bottom:1.5rem;">
    ⚠️ Your attendance is below the 75% required by most institutions. Contact your teacher if this is a mistake.
  </div>
<% } %>

<div class="sis-card" style="padding:0;overflow:hidden;">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9;">
    <h3 style="border:none;padding:0;margin:0;">📋 Full Record (last 120 days)</h3>
  </div>
  <% if (records.length === 0) { %>
    <div style="padding:2.5rem;text-align:center;color:#64748b;">
      No attendance records yet.
    </div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Day</th>
          <th>Status</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% records.forEach(r => {
          const dt = new Date(r.attendance_date);
        %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;">
              <%= dt.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) %>
            </td>
            <td style="color:#64748b;font-size:.85rem;">
              <%= dt.toLocaleDateString('en-GB', { weekday:'long' }) %>
            </td>
            <td>
              <% if (r.status === 'present') { %>
                <span class="sis-badge sis-badge-active">Present</span>
              <% } else if (r.status === 'absent') { %>
                <span class="sis-badge sis-badge-inactive">Absent</span>
              <% } else if (r.status === 'late') { %>
                <span class="sis-badge sis-badge-gold">Late</span>
              <% } else { %>
                <span class="sis-badge" style="background:#e2e8f0;color:#475569;">Excused</span>
              <% } %>
            </td>
            <td style="color:#64748b;font-size:.88rem;"><%= r.notes || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>