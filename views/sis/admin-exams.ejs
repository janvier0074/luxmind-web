<%- include('partials/head', {
  title: 'Exams',
  heading: 'Exam Management',
  subtitle: 'Schedule exams and record results.'
}) %>

<!-- Create exam -->
<div class="exm-card exm-new">
  <div class="exm-card-head">
    <span class="exm-icon">📝</span>
    <div>
      <h3>Schedule a New Exam</h3>
      <p>Create an exam, then open it to record student scores.</p>
    </div>
  </div>

  <form method="POST" action="/sis/admin/exams/new" class="exm-form">
    <div class="exm-field exm-field-wide">
      <label class="exm-lbl">Course *</label>
      <select class="exm-input" name="course_id" required>
        <option value="">— Choose a course —</option>
        <% courses.forEach(c => { %>
          <option value="<%= c.id %>"><%= c.title %></option>
        <% }) %>
      </select>
    </div>
    <div class="exm-field exm-field-wide">
      <label class="exm-lbl">Exam Title *</label>
      <input class="exm-input" name="title" required placeholder="e.g. Midterm Exam" maxlength="80">
    </div>
    <div class="exm-field">
      <label class="exm-lbl">Date *</label>
      <input class="exm-input" type="date" name="exam_date" required>
    </div>
    <div class="exm-field">
      <label class="exm-lbl">Start Time</label>
      <input class="exm-input" type="time" name="start_time">
    </div>
    <div class="exm-field">
      <label class="exm-lbl">Duration (min)</label>
      <input class="exm-input" type="number" name="duration_minutes" value="60" min="10" max="300">
    </div>
    <div class="exm-field">
      <label class="exm-lbl">Room</label>
      <input class="exm-input" name="room" placeholder="e.g. A-201" maxlength="30">
    </div>
    <div class="exm-field">
      <label class="exm-lbl">Max Score</label>
      <input class="exm-input" type="number" name="max_score" value="100" min="1" max="1000">
    </div>
    <div class="exm-field exm-form-actions">
      <button class="exm-submit" type="submit">➕ Schedule Exam</button>
    </div>
  </form>
</div>

<!-- List -->
<h3 class="exm-sec-title">
  All Exams
  <% if (exams.length > 0) { %><span class="exm-sec-count"><%= exams.length %></span><% } %>
</h3>

<% if (exams.length === 0) { %>
  <div class="sis-empty" style="padding:2rem;">No exams scheduled yet.</div>
<% } else { %>
  <div class="exm-list">
    <% exams.forEach(e => {
      const today = new Date().toISOString().slice(0, 10);
      const isPast = e.exam_date < today;
    %>
      <div class="exm-item <%= isPast ? 'exm-item-past' : '' %>">
        <div class="exm-date">
          <div class="exm-date-day"><%= new Date(e.exam_date).getDate() %></div>
          <div class="exm-date-mon"><%= new Date(e.exam_date).toLocaleDateString('en-GB', { month:'short' }) %></div>
        </div>

        <div class="exm-body">
          <div class="exm-title"><%= e.title %></div>
          <div class="exm-course">📚 <%= e.course_title %></div>
          <div class="exm-meta">
            <% if (e.start_time) { %><span>⏰ <%= e.start_time %></span><% } %>
            <% if (e.room) { %><span>📍 <%= e.room %></span><% } %>
            <span>🎯 Max <%= e.max_score %></span>
          </div>
        </div>

        <div class="exm-right">
          <div class="exm-counts">
            <span class="exm-count"><%= e.result_count %>/<%= e.student_count %> graded</span>
          </div>
          <div class="exm-actions">
            <a class="exm-btn exm-btn-primary" href="/sis/admin/exams/<%= e.id %>">Grade →</a>
            <form method="POST" action="/sis/admin/exams/<%= e.id %>/delete" style="display:inline;"
              onsubmit="return confirm('Delete this exam and all its results?');">
              <button class="exm-btn exm-btn-danger" type="submit" title="Delete">🗑️</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<style>
  .exm-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
    margin-bottom: 1.75rem;
  }
  .exm-new {
    background: linear-gradient(180deg, #f0f9ff 0%, #fff 60%);
    border-color: #bae6fd;
  }
  .exm-card-head {
    display: flex; align-items: flex-start; gap: .85rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .exm-icon { font-size: 1.75rem; flex-shrink: 0; }
  .exm-card-head h3 { font-size: 1.05rem; font-weight: 800; color: #0f172a; margin-bottom: .2rem; }
  .exm-card-head p { font-size: .82rem; color: #64748b; line-height: 1.5; }

  .exm-form {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr 1fr auto;
    gap: .65rem;
    align-items: end;
  }
  .exm-field { display: flex; flex-direction: column; min-width: 0; }
  .exm-field-wide { grid-column: span 2; }
  .exm-lbl {
    font-size: .65rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: .1em;
    color: #475569; margin-bottom: .35rem;
  }
  .exm-input {
    width: 100%; padding: .65rem .8rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 9px;
    background: #fff; font-size: .85rem;
    font-family: inherit; color: #0f172a;
    transition: all .15s;
  }
  .exm-input:focus {
    outline: none; border-color: #06b6d4;
    box-shadow: 0 0 0 3px rgba(6,182,212,.15);
  }
  .exm-form-actions { display: flex; }
  .exm-submit {
    padding: .65rem 1.1rem;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: #fff; border: none; border-radius: 9px;
    font-size: .82rem; font-weight: 800;
    cursor: pointer; font-family: inherit;
    box-shadow: 0 6px 14px rgba(6,182,212,.3);
    transition: all .15s;
    white-space: nowrap;
  }
  .exm-submit:hover { transform: translateY(-2px); }

  .exm-sec-title {
    display: flex; align-items: center; gap: .5rem;
    font-size: .75rem; text-transform: uppercase;
    letter-spacing: .15em; color: #64748b;
    font-weight: 800; margin-bottom: 1rem;
  }
  .exm-sec-count {
    background: #0f2942; color: #67e8f9;
    font-size: .68rem; padding: 2px 8px;
    border-radius: 100px; letter-spacing: 0;
  }

  .exm-list { display: flex; flex-direction: column; gap: .75rem; }
  .exm-item {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    gap: 1.1rem;
    align-items: center;
    padding: 1rem 1.15rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #06b6d4;
    border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
    transition: all .15s;
  }
  .exm-item:hover { box-shadow: 0 6px 18px rgba(15,23,42,.08); }
  .exm-item-past { border-left-color: #64748b; }

  .exm-date {
    width: 70px; text-align: center;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: #fff;
    border-radius: 10px;
    padding: .65rem .4rem;
    flex-shrink: 0;
  }
  .exm-item-past .exm-date {
    background: linear-gradient(135deg, #64748b, #475569);
  }
  .exm-date-day { font-size: 1.5rem; font-weight: 900; line-height: 1; }
  .exm-date-mon { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; margin-top: .1rem; }

  .exm-body { min-width: 0; }
  .exm-title {
    font-weight: 800; color: #0f172a;
    font-size: .98rem; margin-bottom: .25rem;
    word-break: break-word;
  }
  .exm-course {
    color: #0891b2; font-size: .82rem;
    font-weight: 600; margin-bottom: .4rem;
    word-break: break-word;
  }
  .exm-meta {
    display: flex; flex-wrap: wrap; gap: .5rem .85rem;
    font-size: .75rem; color: #64748b;
  }

  .exm-right {
    display: flex; flex-direction: column;
    align-items: flex-end; gap: .5rem;
    flex-shrink: 0;
  }
  .exm-counts {
    font-size: .72rem; color: #475569;
    background: #f1f5f9;
    padding: 3px 9px; border-radius: 100px;
    font-weight: 700;
  }
  .exm-actions { display: flex; gap: .4rem; }
  .exm-btn {
    padding: .5rem .9rem;
    border-radius: 8px;
    font-size: .78rem;
    font-weight: 800;
    cursor: pointer; font-family: inherit;
    text-decoration: none;
    border: none;
    transition: all .15s;
    white-space: nowrap;
  }
  .exm-btn-primary {
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: #fff;
    box-shadow: 0 4px 10px rgba(6,182,212,.25);
  }
  .exm-btn-primary:hover { transform: translateY(-1px); }
  .exm-btn-danger {
    background: #fee2e2; color: #991b1b;
    padding: .5rem .7rem;
  }
  .exm-btn-danger:hover { background: #fecaca; }

  @media (max-width: 1100px) {
    .exm-form { grid-template-columns: 1fr 1fr 1fr; }
    .exm-field-wide { grid-column: span 3; }
    .exm-form-actions { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .exm-card { padding: 1.15rem; }
    .exm-form { grid-template-columns: 1fr 1fr; }
    .exm-field-wide { grid-column: span 2; }
    .exm-submit { width: 100%; }

    .exm-item {
      grid-template-columns: 60px 1fr;
      gap: .75rem;
      padding: .85rem;
    }
    .exm-date { width: 60px; padding: .5rem .3rem; }
    .exm-date-day { font-size: 1.25rem; }
    .exm-right {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      border-top: 1px dashed #f1f5f9;
      padding-top: .65rem;
      margin-top: .35rem;
    }
  }
</style>

<%- include('partials/foot') %>