<%- include('partials/head', {
  title: 'Exam Results',
  heading: 'Exam Results',
  subtitle: 'Your exam scores and grades.'
}) %>

<div class="ex-tabs">
  <a class="ex-tab" href="/sis/my/exams">📅 Exam Program</a>
  <a class="ex-tab active" href="/sis/my/exams/results">🏆 Exam Results</a>
</div>

<!-- Stats -->
<% if (results.length > 0) { %>
  <div class="sis-stat-grid">
    <div class="sis-stat gold">
      <div class="sis-stat-num"><%= results.length %></div>
      <div class="sis-stat-lbl">Exams Taken</div>
    </div>
    <div class="sis-stat green">
      <div class="sis-stat-num"><%= avgPct %>%</div>
      <div class="sis-stat-lbl">Average Score</div>
    </div>
  </div>
<% } %>

<h3 class="ex-sec-title">
  All Results
  <% if (results.length > 0) { %><span class="ex-sec-count"><%= results.length %></span><% } %>
</h3>

<% if (results.length === 0) { %>
  <div class="sis-empty" style="padding:2rem;">No exam results yet.</div>
<% } else { %>
  <div class="exr-list">
    <% results.forEach(r => {
      const pct = (r.score !== null && r.max_score > 0) ? Math.round((Number(r.score) / Number(r.max_score)) * 100) : 0;
      const gradeClass = !r.grade ? 'g-empty' :
        r.grade === 'A' ? 'g-a' :
        r.grade === 'B' ? 'g-b' :
        r.grade === 'C' ? 'g-c' :
        r.grade === 'D' ? 'g-d' : 'g-f';
    %>
      <div class="exr-item">
        <div class="exr-grade <%= gradeClass %>"><%= r.grade || '—' %></div>
        <div class="exr-body">
          <div class="exr-title"><%= r.title %></div>
          <div class="exr-course">📚 <%= r.course_title %></div>
          <div class="exr-meta">
            <span class="exr-date">📅 <%= new Date(r.exam_date).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) %></span>
          </div>
          <% if (r.notes) { %>
            <div class="exr-notes">💬 <%= r.notes %></div>
          <% } %>
        </div>
        <div class="exr-score">
          <div class="exr-score-num"><%= r.score %>/<%= r.max_score %></div>
          <div class="exr-score-pct"><%= pct %>%</div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<style>
  .ex-tabs {
    display: flex; gap: .5rem; margin-bottom: 1.5rem;
  }
  .ex-tab {
    padding: .6rem 1.1rem; border-radius: 8px;
    background: #fff; border: 1px solid #e2e8f0;
    color: #475569; font-weight: 700; font-size: .82rem;
    text-decoration: none; transition: all .15s;
  }
  .ex-tab.active {
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: #fff; border-color: transparent;
  }
  .ex-sec-title {
    display: flex; align-items: center; gap: .5rem;
    font-size: .75rem; text-transform: uppercase;
    letter-spacing: .15em; color: #64748b;
    font-weight: 800; margin-bottom: 1rem;
  }
  .ex-sec-count {
    background: #0891b2; color: #fff;
    font-size: .68rem; padding: 2px 8px;
    border-radius: 100px; letter-spacing: 0;
  }

  .exr-list { display: flex; flex-direction: column; gap: .75rem; }
  .exr-item {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.15rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
    transition: all .15s;
  }
  .exr-item:hover { box-shadow: 0 6px 18px rgba(15,23,42,.08); }

  .exr-grade {
    width: 60px; height: 60px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 1.5rem;
    font-family: Georgia, serif;
    color: #fff;
    flex-shrink: 0;
  }
  .g-a { background: linear-gradient(135deg, #10b981, #059669); }
  .g-b { background: linear-gradient(135deg, #06b6d4, #0891b2); }
  .g-c { background: linear-gradient(135deg, #f59e0b, #d97706); }
  .g-d { background: linear-gradient(135deg, #f97316, #ea580c); }
  .g-f { background: linear-gradient(135deg, #ef4444, #dc2626); }
  .g-empty { background: #e2e8f0; color: #94a3b8; }

  .exr-body { min-width: 0; }
  .exr-title {
    font-weight: 800; color: #0f172a;
    font-size: .98rem; line-height: 1.3;
    word-break: break-word;
    margin-bottom: .25rem;
  }
  .exr-course {
    color: #0891b2; font-size: .82rem;
    font-weight: 600; margin-bottom: .35rem;
    word-break: break-word;
  }
  .exr-meta {
    display: flex; gap: .75rem;
    font-size: .76rem; color: #64748b;
  }
  .exr-notes {
    color: #475569; font-size: .78rem;
    margin-top: .35rem;
    font-style: italic;
    word-break: break-word;
  }

  .exr-score { text-align: right; flex-shrink: 0; }
  .exr-score-num {
    font-family: ui-monospace, monospace;
    font-weight: 800; color: #0f172a;
    font-size: 1rem;
    line-height: 1;
  }
  .exr-score-pct {
    color: #0891b2; font-weight: 800;
    font-size: .8rem;
    margin-top: .25rem;
  }

  @media (max-width: 700px) {
    .ex-tabs { flex-direction: column; }
    .ex-tab { text-align: center; }
    .exr-item {
      grid-template-columns: 52px 1fr;
      gap: .75rem;
      padding: .85rem;
    }
    .exr-grade { width: 52px; height: 52px; font-size: 1.3rem; }
    .exr-score {
      grid-column: 1 / -1;
      text-align: left;
      display: flex; align-items: baseline; gap: .75rem;
      padding-top: .5rem;
      border-top: 1px dashed #f1f5f9;
      margin-top: .35rem;
    }
    .exr-score-pct { margin-top: 0; }
  }
</style>

<%- include('partials/foot') %>