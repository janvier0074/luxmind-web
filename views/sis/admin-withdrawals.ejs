<%- include('partials/head', {
  title: 'Course Withdrawals',
  heading: 'Course Withdrawals',
  subtitle: 'Approve or reject student withdrawal requests.'
}) %>

<h3 class="cwd-sec-title">
  ⏳ Pending Requests
  <% if (pending.length > 0) { %><span class="cwd-sec-count"><%= pending.length %></span><% } %>
</h3>

<% if (pending.length === 0) { %>
  <div class="sis-empty" style="padding:2rem;">No pending withdrawal requests. All caught up ✅</div>
<% } else { %>
  <div class="cwd-grid">
    <% pending.forEach(r => { %>
      <div class="cwd-card">
        <div class="cwd-card-head">
          <div>
            <div class="cwd-student"><%= r.student_name || r.student_username %></div>
            <div class="cwd-email"><%= r.student_email || '—' %></div>
          </div>
          <div class="cwd-date">
            <%= new Date(r.requested_at).toLocaleDateString('en-GB', { day:'2-digit', month:'short' }) %>
          </div>
        </div>

        <div class="cwd-body">
          <div class="cwd-lbl">Course to Withdraw</div>
          <div class="cwd-course"><%= r.course_title %></div>

          <div class="cwd-lbl" style="margin-top:.75rem;">Reason</div>
          <div class="cwd-reason"><%= r.reason %></div>
        </div>

        <div class="cwd-actions">
          <button class="cwd-btn cwd-btn-approve" type="button"
            onclick="approveW(<%= r.id %>)">✓ Approve</button>
          <button class="cwd-btn cwd-btn-reject" type="button"
            onclick="rejectW(<%= r.id %>)">✕ Reject</button>
        </div>

        <form method="POST" action="/sis/admin/withdrawals/<%= r.id %>/approve" id="app-<%= r.id %>" style="display:none;"></form>
        <form method="POST" action="/sis/admin/withdrawals/<%= r.id %>/reject" id="rej-<%= r.id %>" style="display:none;">
          <input type="hidden" name="admin_notes" id="rej-notes-<%= r.id %>" value="">
        </form>
      </div>
    <% }) %>
  </div>
<% } %>

<h3 class="cwd-sec-title" style="margin-top:2rem;">🕐 Recently Handled</h3>

<% if (handled.length === 0) { %>
  <div class="sis-empty" style="padding:1.5rem;">Nothing handled yet.</div>
<% } else { %>
  <div class="cwd-table-wrap">
    <table class="cwd-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Course</th>
          <th style="width:110px;text-align:center;">Status</th>
          <th style="width:130px;">Reviewed</th>
        </tr>
      </thead>
      <tbody>
        <% handled.forEach(r => { %>
          <tr>
            <td><strong><%= r.student_name || r.student_username %></strong></td>
            <td><%= r.course_title %></td>
            <td style="text-align:center;">
              <% if (r.status === 'approved') { %>
                <span class="cwd-badge cwd-badge-approved">✅ Approved</span>
              <% } else { %>
                <span class="cwd-badge cwd-badge-rejected">❌ Rejected</span>
              <% } %>
            </td>
            <td style="color:#64748b;font-size:.82rem;">
              <%= r.reviewed_at ? new Date(r.reviewed_at).toLocaleDateString('en-GB', { day:'2-digit', month:'short' }) : '—' %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<style>
  .cwd-sec-title {
    display: flex; align-items: center; gap: .5rem;
    font-size: .75rem; text-transform: uppercase;
    letter-spacing: .15em; color: #64748b;
    font-weight: 800; margin-bottom: 1rem;
  }
  .cwd-sec-count {
    background: #f59e0b; color: #fff;
    font-size: .68rem; padding: 2px 8px;
    border-radius: 100px; letter-spacing: 0;
  }

  .cwd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }
  .cwd-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #f59e0b;
    border-radius: 12px;
    padding: 1.25rem;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
  }
  .cwd-card-head {
    display: flex; justify-content: space-between;
    align-items: flex-start; gap: .75rem;
    padding-bottom: .85rem;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: .85rem;
  }
  .cwd-student { font-weight: 800; color: #0f172a; font-size: .95rem; }
  .cwd-email { color: #64748b; font-size: .78rem; margin-top: 2px; word-break: break-all; }
  .cwd-date { color: #94a3b8; font-size: .75rem; font-weight: 700; flex-shrink: 0; }

  .cwd-lbl {
    font-size: .65rem; text-transform: uppercase;
    letter-spacing: .12em; color: #94a3b8;
    font-weight: 800; margin-bottom: .25rem;
  }
  .cwd-course {
    font-weight: 700; color: #0891b2;
    font-size: .95rem; margin-bottom: .5rem;
  }
  .cwd-reason {
    color: #475569; font-size: .85rem; line-height: 1.5;
    background: #f8fafc; padding: .6rem .75rem;
    border-radius: 6px;
    word-break: break-word;
  }
  .cwd-body { margin-bottom: 1rem; }

  .cwd-actions { display: flex; gap: .5rem; }
  .cwd-btn {
    flex: 1; padding: .6rem;
    border: none; border-radius: 8px;
    font-weight: 800; font-size: .82rem;
    cursor: pointer; font-family: inherit;
    transition: all .15s;
  }
  .cwd-btn-approve {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
  }
  .cwd-btn-approve:hover { transform: translateY(-1px); box-shadow: 0 4px 10px rgba(16,185,129,.35); }
  .cwd-btn-reject {
    background: #fff; color: #991b1b;
    border: 1.5px solid #fecaca;
  }
  .cwd-btn-reject:hover { background: #fee2e2; }

  .cwd-table-wrap {
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 12px; overflow: hidden;
  }
  .cwd-table {
    width: 100%; border-collapse: collapse; table-layout: fixed;
  }
  .cwd-table thead { background: #f8fafc; }
  .cwd-table th {
    text-align: left; padding: .7rem .9rem;
    font-size: .68rem; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    color: #64748b; border-bottom: 2px solid #e2e8f0;
  }
  .cwd-table td {
    padding: .75rem .9rem;
    border-bottom: 1px solid #f1f5f9;
    font-size: .85rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .cwd-badge {
    display: inline-block; padding: 3px 10px;
    font-size: .72rem; font-weight: 800;
    border-radius: 100px; letter-spacing: .04em;
  }
  .cwd-badge-approved { background: #d1fae5; color: #065f46; }
  .cwd-badge-rejected { background: #fee2e2; color: #991b1b; }

  @media (max-width: 700px) {
    .cwd-grid { grid-template-columns: 1fr; }
    .cwd-table-wrap { overflow-x: auto; }
    .cwd-table { min-width: 550px; }
  }
</style>

<script>
  function approveW(id) {
    if (!confirm('Approve this withdrawal? The student will be removed from the course.')) return;
    document.getElementById('app-' + id).submit();
  }
  function rejectW(id) {
    var note = prompt('Reason for rejection (shown to student):');
    if (note === null) return;
    document.getElementById('rej-notes-' + id).value = note || '';
    document.getElementById('rej-' + id).submit();
  }
</script>

<%- include('partials/foot') %>