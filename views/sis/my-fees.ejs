<%- include('partials/head', {
  title: 'Accounting',
  heading: 'Accounting',
  subtitle: 'View your invoices, payments, and financial status.'
}) %>

<!-- Top Debt Stats (Matches CIU) -->
<div class="acc-top-stats">
  <div class="acc-stat-box">
    <div class="acc-stat-title">Full Access Limit</div>
    <div class="acc-stat-val"><%= fullAccessLimit %> EUR</div>
    <div class="acc-stat-sub">Provisional: 400 EUR</div>
  </div>
  
  <div class="acc-stat-box acc-danger">
    <div class="acc-stat-title">Current Debt</div>
    <div class="acc-stat-val"><%= Number(balance).toLocaleString() %> BIF</div>
    <div class="acc-stat-sub">Total unpaid balance</div>
  </div>

  <div class="acc-stat-box acc-warning">
    <div class="acc-stat-title">Approaching Debt</div>
    <div class="acc-stat-val"><%= Number(approachingDebt).toLocaleString() %> BIF</div>
    <div class="acc-stat-sub">Debt + 200 EUR limit</div>
  </div>

  <div class="acc-stat-box acc-dark">
    <div class="acc-stat-title">Total Debt</div>
    <div class="acc-stat-val"><%= Number(totalOwed).toLocaleString() %> BIF</div>
    <div class="acc-stat-sub">Total invoiced amount</div>
  </div>
</div>

<!-- Pay Now Banner (if debt exists) -->
<% if (balance > 0) { %>
  <div class="acc-pay-banner">
    <div>
      <div class="acc-pay-title">You have an outstanding balance.</div>
      <div class="acc-pay-desc">Clear your balance to unlock Course Registration.</div>
    </div>
    <form method="POST" action="/sis/my/fees/pay">
      <button type="submit" class="acc-pay-btn">💳 Pay Now via Bank</button>
    </form>
  </div>
<% } %>

<!-- Filters (Mockup matching CIU) -->
<div class="acc-filters">
  <div class="acc-filter-group">
    <label>Invoice Categories</label>
    <select class="acc-select">
      <option>All categories</option>
      <option>Education Fee</option>
      <option>Late Payment</option>
    </select>
  </div>
  <div class="acc-filter-group">
    <label>Term/Year</label>
    <select class="acc-select">
      <option>All terms / years</option>
      <option>Term 1 - 2026</option>
    </select>
  </div>
  <div class="acc-filter-group" style="flex:1;">
    <label>Search</label>
    <input type="text" class="acc-input" placeholder="Search transactions...">
  </div>
</div>

<!-- Ledger Table -->
<div class="acc-table-wrap">
  <table class="acc-table">
    <thead>
      <tr>
        <th style="width:120px;">Date</th>
        <th style="width:100px;">Type</th>
        <th>Description</th>
        <th style="text-align:right;width:130px;">Charges (+)</th>
        <th style="text-align:right;width:130px;">Payments (-)</th>
        <th style="width:120px;">Installment</th>
      </tr>
    </thead>
    <tbody>
      <% if (ledger.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align:center;padding:2rem;color:#64748b;">No transactions found.</td>
        </tr>
      <% } else { %>
        <% ledger.forEach(t => { %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.82rem;color:#475569;">
              <%= t.date.toLocaleDateString('en-GB', { day:'2-digit', month:'2-digit', year:'numeric' }) %>
            </td>
            <td>
              <% if (t.type === 'Invoice') { %>
                <span class="acc-badge acc-badge-invoice">Invoice</span>
              <% } else { %>
                <span class="acc-badge acc-badge-payment">Payment</span>
              <% } %>
            </td>
            <td style="color:#0f172a;font-weight:600;font-size:.85rem;"><%= t.description %></td>
            <td style="text-align:right;font-family:ui-monospace,monospace;font-weight:700;color:#b91c1c;">
              <%= t.charge > 0 ? Number(t.charge).toLocaleString() + ' BIF' : '-' %>
            </td>
            <td style="text-align:right;font-family:ui-monospace,monospace;font-weight:700;color:#047857;">
              <%= t.credit > 0 ? Number(t.credit).toLocaleString() + ' BIF' : '-' %>
            </td>
            <td style="color:#64748b;font-size:.8rem;"><%= t.installment %></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
  
  <div class="acc-pagination">
    <div>Showing <%= ledger.length %> entries</div>
    <div class="acc-pages">
      <span class="acc-page active">1</span>
    </div>
  </div>
</div>

<style>
  /* Top Stats */
  .acc-top-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem; margin-bottom: 1.5rem;
  }
  .acc-stat-box {
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 10px; padding: 1.25rem;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
  }
  .acc-stat-title {
    font-size: .68rem; text-transform: uppercase;
    letter-spacing: .12em; color: #64748b; font-weight: 800;
  }
  .acc-stat-val {
    font-family: Georgia, serif;
    font-size: 1.5rem; font-weight: 900; color: #0f172a;
    margin: .35rem 0 .15rem;
  }
  .acc-stat-sub { font-size: .75rem; color: #94a3b8; font-weight: 600; }
  
  .acc-danger  { border-left: 4px solid #ef4444; }
  .acc-warning { border-left: 4px solid #f59e0b; }
  .acc-dark    { border-left: 4px solid #1e293b; }

  /* Pay Banner */
  .acc-pay-banner {
    background: linear-gradient(135deg, #0f2942, #0891b2);
    color: #fff; padding: 1.5rem; border-radius: 12px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;
    box-shadow: 0 8px 20px rgba(6,182,212,.25);
  }
  .acc-pay-title { font-size: 1.1rem; font-weight: 800; margin-bottom: .2rem; }
  .acc-pay-desc { font-size: .85rem; opacity: .85; }
  .acc-pay-btn {
    background: #fff; color: #0f2942; border: none;
    padding: .8rem 1.5rem; border-radius: 8px;
    font-size: .9rem; font-weight: 900; cursor: pointer;
    transition: all .15s;
  }
  .acc-pay-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.2); }

  /* Filters */
  .acc-filters {
    display: flex; gap: 1rem; flex-wrap: wrap;
    background: #fff; border: 1px solid #e2e8f0;
    padding: 1.25rem; border-radius: 12px; margin-bottom: 1rem;
  }
  .acc-filter-group { display: flex; flex-direction: column; min-width: 180px; }
  .acc-filter-group label {
    font-size: .65rem; text-transform: uppercase;
    letter-spacing: .1em; color: #64748b; font-weight: 800;
    margin-bottom: .4rem;
  }
  .acc-select, .acc-input {
    padding: .6rem .8rem; border: 1.5px solid #cbd5e1;
    border-radius: 8px; font-size: .85rem; background: #f8fafc;
    font-family: inherit; color: #0f172a;
  }
  .acc-select:focus, .acc-input:focus { outline: none; border-color: #06b6d4; background: #fff; }

  /* Table */
  .acc-table-wrap {
    background: #fff; border: 1px solid #e2e8f0;
    border-radius: 12px; overflow: hidden;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
  }
  .acc-table { width: 100%; border-collapse: collapse; }
  .acc-table thead { background: #f8fafc; }
  .acc-table th {
    text-align: left; padding: .8rem 1rem;
    font-size: .68rem; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase;
    color: #64748b; border-bottom: 2px solid #e2e8f0;
  }
  .acc-table td {
    padding: .8rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
  }
  .acc-table tbody tr:hover { background: #f8fafc; }

  .acc-badge {
    display: inline-block; padding: 3px 9px;
    font-size: .68rem; font-weight: 800;
    border-radius: 100px; letter-spacing: .04em;
  }
  .acc-badge-invoice { background: #fee2e2; color: #991b1b; }
  .acc-badge-payment { background: #d1fae5; color: #065f46; }

  .acc-pagination {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem; border-top: 1px solid #e2e8f0;
    font-size: .82rem; color: #64748b; background: #f8fafc;
  }
  .acc-pages { display: flex; gap: .25rem; }
  .acc-page {
    padding: .3rem .7rem; border: 1px solid #e2e8f0;
    border-radius: 6px; background: #fff; cursor: pointer;
    font-weight: 700;
  }
  .acc-page.active { background: #06b6d4; color: #fff; border-color: transparent; }

  /* Mobile */
  @media (max-width: 700px) {
    .acc-top-stats { grid-template-columns: 1fr 1fr; }
    .acc-filters { flex-direction: column; }
    .acc-table-wrap { overflow-x: auto; }
    .acc-table { min-width: 700px; }
    .acc-pay-banner { flex-direction: column; align-items: flex-start; }
    .acc-pay-btn { width: 100%; margin-top: .5rem; }
  }
</style>

<%- include('partials/foot') %>