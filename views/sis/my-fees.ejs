<%- include('partials/head', {
  title: 'My Fees',
  heading: 'My Fees',
  subtitle: 'Your payment history and balance.'
}) %>

<div style="margin-bottom:1.5rem;">
  <a class="sis-btn sis-btn-outline" href="/sis/my">← Back to Overview</a>
</div>

<div class="sis-stat-grid">
<% if (balance > 0) { %>
  <div class="sis-card" style="background:linear-gradient(135deg,#0f2942,#0891b2); color:#fff; border:none; margin-bottom:2rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
    <div>
      <div style="font-size:1.2rem; font-weight:800;">Outstanding Balance</div>
      <div style="font-size:1.5rem; font-family:Georgia, serif; font-weight:900; color:#67e8f9; margin-top:.2rem;">
        <%= Number(balance).toLocaleString() %> BIF
      </div>
      <div style="font-size:.85rem; opacity:.85; margin-top:.3rem;">Clear your balance to unlock course registration.</div>
    </div>
    <form method="POST" action="/sis/my/fees/pay">
      <button type="submit" style="background:#fff; color:#0f2942; border:none; padding:.8rem 1.5rem; border-radius:10px; font-size:.95rem; font-weight:900; cursor:pointer; box-shadow:0 6px 16px rgba(0,0,0,.2);">
        💳 Pay Now via Bank
      </button>
    </form>
  </div>
<% } %>
  <div class="sis-stat slate">
    <div class="sis-stat-num"><%= Number(totalOwed || 0).toLocaleString() %></div>
    <div class="sis-stat-lbl">Total Fees (BIF)</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= Number(totalPaid || 0).toLocaleString() %></div>
    <div class="sis-stat-lbl">Total Paid (BIF)</div>
  </div>
  <div class="sis-stat <%= balance > 0 ? 'red' : 'green' %>">
    <div class="sis-stat-num"><%= Number(balance || 0).toLocaleString() %></div>
    <div class="sis-stat-lbl"><%= balance > 0 ? 'Balance Due' : 'Fully Paid' %> (BIF)</div>
  </div>
</div>

<div class="sis-card">
  <h3>📋 Fee Structure — <%= profile && profile.class_level || 'Not assigned' %></h3>
  <% if (fees.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">No fee structure set for your class yet.</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Term</th>
          <th>Description</th>
          <th style="text-align:right;">Amount (BIF)</th>
        </tr>
      </thead>
      <tbody>
        <% fees.forEach(f => { %>
          <tr>
            <td><strong><%= f.term %></strong></td>
            <td style="color:#57534e;"><%= f.description || 'Tuition' %></td>
            <td style="text-align:right;font-family:Georgia,serif;font-weight:700;">
              <%= Number(f.amount).toLocaleString() %>
            </td>
          </tr>
        <% }) %>
        <tr style="background:#f5f1e8;">
          <td colspan="2" style="font-weight:700;text-align:right;">Total</td>
          <td style="text-align:right;font-family:Georgia,serif;font-weight:700;color:#b45309;">
            <%= Number(totalOwed).toLocaleString() %>
          </td>
        </tr>
      </tbody>
    </table>
  <% } %>
</div>

<div class="sis-card">
  <h3>💳 Payment History</h3>
  <% if (payments.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">No payments recorded yet.</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Term</th>
          <th>Method</th>
          <th>Receipt #</th>
          <th style="text-align:right;">Amount (BIF)</th>
        </tr>
      </thead>
      <tbody>
        <% payments.forEach(p => { %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;">
              <%= p.paid_at ? new Date(p.paid_at).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) : '—' %>
            </td>
            <td><%= p.term || '—' %></td>
            <td><%= p.method || '—' %></td>
            <td style="font-family:ui-monospace,monospace;font-size:.82rem;"><%= p.receipt_number || '—' %></td>
            <td style="text-align:right;font-weight:700;color:#166534;">
              <%= Number(p.amount).toLocaleString() %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>