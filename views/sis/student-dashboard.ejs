<%- include('partials/head', {
  title: 'My Record',
  heading: 'Good day, ' + (user.full_name ? user.full_name.split(' ')[0] : user.username),
  subtitle: 'Your academic record at a glance.'
}) %>

<div class="sis-stat-grid">
  <div class="sis-stat gold">
    <div class="sis-stat-num"><%= attSummary.pct %>%</div>
    <div class="sis-stat-lbl">Attendance</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= attSummary.present || 0 %></div>
    <div class="sis-stat-lbl">Days Present</div>
  </div>
  <div class="sis-stat red">
    <div class="sis-stat-num"><%= attSummary.absent || 0 %></div>
    <div class="sis-stat-lbl">Days Absent</div>
  </div>
  <div class="sis-stat slate">
    <div class="sis-stat-num"><%= attSummary.total || 0 %></div>
    <div class="sis-stat-lbl">Days Marked</div>
  </div>
</div>

<h3 style="font-size:1.05rem;color:#0f172a;margin-bottom:1rem;font-weight:700;">Quick Access</h3>

<div class="sis-tiles">
  <a class="sis-tile" href="/sis/my/timetable">
    <span class="sis-tile-icon">📅</span>
    <div class="sis-tile-label">Timetable</div>
  </a>
  <a class="sis-tile" href="/sis/my/attendance">
    <span class="sis-tile-icon">📋</span>
    <div class="sis-tile-label">Attendance Detail</div>
  </a>
  <a class="sis-tile" href="/student/grades">
    <span class="sis-tile-icon">🏆</span>
    <div class="sis-tile-label">My Grades</div>
  </a>
  <a class="sis-tile" href="/sis/my/fees">
    <span class="sis-tile-icon">💰</span>
    <div class="sis-tile-label">My Fees</div>
  </a>
  <a class="sis-tile" href="/profile">
    <span class="sis-tile-icon">👤</span>
    <div class="sis-tile-label">My Profile</div>
  </a>
  <a class="sis-tile" href="/notifications">
    <span class="sis-tile-icon">🔔</span>
    <div class="sis-tile-label">Notifications</div>
  </a>
  <a class="sis-tile" href="/messages">
    <span class="sis-tile-icon">💬</span>
    <div class="sis-tile-label">Messages</div>
  </a>
  <a class="sis-tile" href="/settings">
    <span class="sis-tile-icon">⚙️</span>
    <div class="sis-tile-label">Settings</div>
  </a>
</div>

<div class="sis-card">
  <h3>📋 My Details</h3>
  <table class="sis-table" style="border:none;">
    <tbody>
      <tr>
        <td style="color:#64748b;width:35%;">Admission #</td>
        <td style="font-family:ui-monospace,monospace;font-size:.9rem;font-weight:700;"><%= profile && profile.admission_number || '—' %></td>
      </tr>
      <tr>
        <td style="color:#64748b;">Class</td>
        <td><strong><%= profile && profile.class_level || '—' %></strong></td>
      </tr>
      <tr>
        <td style="color:#64748b;">Date of Birth</td>
        <td><%= profile && profile.date_of_birth ? new Date(profile.date_of_birth).toLocaleDateString('en-GB', { day:'2-digit', month:'long', year:'numeric' }) : '—' %></td>
      </tr>
      <tr>
        <td style="color:#64748b;">Status</td>
        <td><span class="sis-badge sis-badge-active"><%= profile && profile.status || 'active' %></span></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="sis-card">
  <h3>📅 Recent Attendance</h3>
  <% if (recent.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">No attendance records yet.</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Status</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(r => { %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;">
              <%= new Date(r.attendance_date).toLocaleDateString('en-GB', { weekday:'short', day:'2-digit', month:'short' }) %>
            </td>
            <td>
              <% if (r.status === 'present') { %>
                <span class="sis-badge sis-badge-active">Present</span>
              <% } else if (r.status === 'absent') { %>
                <span class="sis-badge sis-badge-inactive">Absent</span>
              <% } else if (r.status === 'late') { %>
                <span class="sis-badge sis-badge-gold">Late</span>
              <% } else { %>
                <span class="sis-badge" style="background:#e2e8f0;color:#475569;">Excused</span>
              <% } %>
            </td>
            <td style="color:#64748b;font-size:.88rem;"><%= r.notes || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>