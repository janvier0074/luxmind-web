<%
  const today = new Date();
  const hour = today.getHours();
  const greeting = hour < 12 ? 'Good morning' : (hour < 18 ? 'Good afternoon' : 'Good evening');
  const dayName = today.toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
  const firstName = user.full_name ? user.full_name.split(' ')[0] : user.username;
%>

<%- include('partials/head', {
  title: 'My Record',
  heading: 'Dashboard',
  subtitle: 'Your academic record at a glance.'
}) %>

<div class="sis-welcome">
  <div>
    <div class="sis-welcome-greeting"><%= greeting %>, <%= firstName %> 👋</div>
    <div class="sis-welcome-date"><%= dayName %></div>
  </div>
  <div class="sis-welcome-user">
    <strong><%= profile && profile.class_level || 'No class assigned' %></strong>
    <% if (profile && profile.admission_number) { %>
      Admission #: <%= profile.admission_number %>
    <% } %>
  </div>
</div>

<div class="sis-stat-grid">
  <div class="sis-stat gold">
    <div class="sis-stat-num"><%= attSummary.pct %>%</div>
    <div class="sis-stat-lbl">Attendance Rate</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= attSummary.present || 0 %></div>
    <div class="sis-stat-lbl">Days Present</div>
  </div>
  <div class="sis-stat red">
    <div class="sis-stat-num"><%= attSummary.absent || 0 %></div>
    <div class="sis-stat-lbl">Days Absent</div>
  </div>
  <div class="sis-stat slate">
    <div class="sis-stat-num"><%= attSummary.total || 0 %></div>
    <div class="sis-stat-lbl">Days Marked</div>
  </div>
</div>

<h3 style="font-size:1.15rem;color:#0f172a;margin-bottom:1.1rem;font-weight:800;">⚡ Quick Access</h3>

<div class="sis-tiles">
  <a class="sis-tile tile-blue" href="/sis/my/timetable">
    <span class="sis-tile-icon">📅</span>
    <div class="sis-tile-label">Timetable</div>
    <div class="sis-tile-sub">Your courses</div>
  </a>
  <a class="sis-tile tile-green" href="/sis/my/attendance">
    <span class="sis-tile-icon">📋</span>
    <div class="sis-tile-label">Attendance</div>
    <div class="sis-tile-sub">Present · Absent · Late</div>
  </a>
  <a class="sis-tile tile-amber" href="https://luxmind.onrender.com/student/grades">
    <span class="sis-tile-icon">🏆</span>
    <div class="sis-tile-label">My Grades</div>
    <div class="sis-tile-sub">Quiz & assignment scores</div>
  </a>
  <a class="sis-tile tile-purple" href="/sis/my/fees">
    <span class="sis-tile-icon">💰</span>
    <div class="sis-tile-label">My Fees</div>
    <div class="sis-tile-sub">Balance & payments</div>
  </a>
  <a class="sis-tile tile-cyan" href="https://luxmind.onrender.com/student/courses">
    <span class="sis-tile-icon">📚</span>
    <div class="sis-tile-label">My Courses</div>
    <div class="sis-tile-sub">Enrolled lessons</div>
  </a>
  <a class="sis-tile tile-pink" href="https://luxmind.onrender.com/messages">
    <span class="sis-tile-icon">💬</span>
    <div class="sis-tile-label">Messages</div>
    <div class="sis-tile-sub">Talk to teachers</div>
  </a>
  <a class="sis-tile tile-indigo" href="https://luxmind.onrender.com/student/assignments">
    <span class="sis-tile-icon">📋</span>
    <div class="sis-tile-label">Assignments</div>
    <div class="sis-tile-sub">Submit & review</div>
  </a>
  <a class="sis-tile tile-rose" href="https://luxmind.onrender.com/my-certificates">
    <span class="sis-tile-icon">🎓</span>
    <div class="sis-tile-label">Certificates</div>
    <div class="sis-tile-sub">Your achievements</div>
  </a>
</div>

<div class="sis-card">
  <h3>📋 My Details</h3>
  <table class="sis-table" style="border:none;">
    <tbody>
      <tr>
        <td style="color:#64748b;width:35%;">Admission #</td>
        <td style="font-family:ui-monospace,monospace;font-size:.9rem;font-weight:700;"><%= profile && profile.admission_number || '—' %></td>
      </tr>
      <tr>
        <td style="color:#64748b;">Class</td>
        <td><strong><%= profile && profile.class_level || '—' %></strong></td>
      </tr>
      <tr>
        <td style="color:#64748b;">Date of Birth</td>
        <td><%= profile && profile.date_of_birth ? new Date(profile.date_of_birth).toLocaleDateString('en-GB', { day:'2-digit', month:'long', year:'numeric' }) : '—' %></td>
      </tr>
      <tr>
        <td style="color:#64748b;">Status</td>
        <td><span class="sis-badge sis-badge-active"><%= profile && profile.status || 'active' %></span></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="sis-card">
  <h3>📅 Recent Attendance</h3>
  <% if (recent.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">No attendance records yet.</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Status</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(r => { %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;">
              <%= new Date(r.attendance_date).toLocaleDateString('en-GB', { weekday:'short', day:'2-digit', month:'short' }) %>
            </td>
            <td>
              <% if (r.status === 'present') { %>
                <span class="sis-badge sis-badge-active">Present</span>
              <% } else if (r.status === 'absent') { %>
                <span class="sis-badge sis-badge-inactive">Absent</span>
              <% } else if (r.status === 'late') { %>
                <span class="sis-badge sis-badge-gold">Late</span>
              <% } else { %>
                <span class="sis-badge" style="background:#e2e8f0;color:#475569;">Excused</span>
              <% } %>
            </td>
            <td style="color:#64748b;font-size:.88rem;"><%= r.notes || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>