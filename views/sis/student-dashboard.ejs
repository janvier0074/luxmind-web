<%- include('partials/head', {
  title: 'My SIS',
  heading: 'Welcome, ' + (user.full_name || user.username),
  subtitle: 'Your academic record.'
}) %>

<div class="sis-stat-grid">
  <div class="sis-stat gold">
    <div class="sis-stat-num"><%= attSummary.pct %>%</div>
    <div class="sis-stat-lbl">Attendance</div>
  </div>
  <div class="sis-stat green">
    <div class="sis-stat-num"><%= attSummary.present || 0 %></div>
    <div class="sis-stat-lbl">Days Present</div>
  </div>
  <div class="sis-stat red">
    <div class="sis-stat-num"><%= attSummary.absent || 0 %></div>
    <div class="sis-stat-lbl">Days Absent</div>
  </div>
  <div class="sis-stat slate">
    <div class="sis-stat-num"><%= attSummary.total || 0 %></div>
    <div class="sis-stat-lbl">Total Days</div>
  </div>
</div>

<div class="sis-card">
  <h3>Quick Links</h3>
  <div style="display:flex;gap:.75rem;flex-wrap:wrap;">
    <a class="sis-btn sis-btn-gold" href="/sis/my/attendance">📅 My Attendance</a>
    <a class="sis-btn sis-btn-outline" href="/student/grades">🏆 My Grades</a>
    <a class="sis-btn sis-btn-outline" href="/student">📚 Back to Learning</a>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem;">

  <div class="sis-card">
    <h3>📋 My Details</h3>
    <table class="sis-table" style="border:none;">
      <tbody>
        <tr>
          <td style="color:#78716c;width:45%;">Admission #</td>
          <td style="font-family:ui-monospace,monospace;font-size:.85rem;"><%= profile && profile.admission_number || '—' %></td>
        </tr>
        <tr>
          <td style="color:#78716c;">Class</td>
          <td><%= profile && profile.class_level || '—' %></td>
        </tr>
        <tr>
          <td style="color:#78716c;">Date of Birth</td>
          <td><%= profile && profile.date_of_birth ? new Date(profile.date_of_birth).toLocaleDateString() : '—' %></td>
        </tr>
        <tr>
          <td style="color:#78716c;">Status</td>
          <td><span class="sis-badge sis-badge-active"><%= profile && profile.status || 'active' %></span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="sis-card">
    <h3>💰 Fees</h3>
    <div style="text-align:center;padding:1rem 0;">
      <div style="font-family:Georgia,serif;font-size:2rem;font-weight:700;color:#166534;">
        <%= Number(totalPaid || 0).toLocaleString() %>
      </div>
      <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.12em;color:#78716c;margin-top:.5rem;">
        Total Paid (BIF)
      </div>
    </div>
  </div>

</div>

<div class="sis-card">
  <h3>📅 Recent Attendance</h3>
  <% if (recent.length === 0) { %>
    <div class="sis-empty" style="padding:1.5rem;">No attendance records yet.</div>
  <% } else { %>
    <table class="sis-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Status</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(r => { %>
          <tr>
            <td style="font-family:ui-monospace,monospace;font-size:.85rem;">
              <%= new Date(r.attendance_date).toLocaleDateString('en-GB', { weekday:'short', day:'2-digit', month:'short', year:'numeric' }) %>
            </td>
            <td>
              <% if (r.status === 'present') { %>
                <span class="sis-badge sis-badge-active">Present</span>
              <% } else if (r.status === 'absent') { %>
                <span class="sis-badge sis-badge-inactive">Absent</span>
              <% } else if (r.status === 'late') { %>
                <span class="sis-badge sis-badge-gold">Late</span>
              <% } else { %>
                <span class="sis-badge" style="background:#e7e5e4;color:#44403c;">Excused</span>
              <% } %>
            </td>
            <td style="color:#57534e;font-size:.88rem;"><%= r.notes || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/foot') %>