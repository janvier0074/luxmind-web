<%- include('partials/head', {
  title: 'CGPA Calculator',
  heading: 'CGPA Calculator',
  subtitle: 'Track your GPA and plan your next semester.'
}) %>

<!-- ============ SUMMARY HERO ============ -->
<div class="cg-hero">
  <div class="cg-hero-glow"></div>
  <div class="cg-hero-main">
    <div class="cg-hero-label">Cumulative GPA</div>
    <div class="cg-hero-num"><%= cgpa %></div>
    <div class="cg-hero-scale">out of 4.00</div>
  </div>
  <div class="cg-hero-stats">
    <div class="cg-hs">
      <div class="cg-hs-num"><%= totalCredits %></div>
      <div class="cg-hs-lbl">Credits</div>
    </div>
    <div class="cg-hs">
      <div class="cg-hs-num"><%= entries.length %></div>
      <div class="cg-hs-lbl">Courses</div>
    </div>
    <div class="cg-hs">
      <div class="cg-hs-num"><%= semesterStats.length %></div>
      <div class="cg-hs-lbl">Semesters</div>
    </div>
  </div>
</div>

<!-- ============ TARGET PLANNER ============ -->
<% if (entries.length > 0) { %>
<div class="cg-panel">
  <div class="cg-panel-head">
    <span class="cg-panel-icon">🎯</span>
    <div>
      <h3>What If? — Target Planner</h3>
      <p>Assuming <%= nextCredits %> credits next semester, here's the GPA you need:</p>
    </div>
  </div>

  <div class="cg-targets">
    <% targets.forEach(t => { %>
      <div class="cg-target <%= t.achievable ? 'cg-target-ok' : 'cg-target-no' %>">
        <div class="cg-target-gpa">
          <span class="cg-target-gpa-lbl">Target</span>
          <span class="cg-target-gpa-num"><%= t.target.toFixed(2) %></span>
        </div>
        <div class="cg-target-need">
          <% if (t.needed === 'Not possible') { %>
            <span class="cg-need-no">Not achievable</span>
          <% } else if (t.needed === 'Already guaranteed') { %>
            <span class="cg-need-yes">Already guaranteed</span>
          <% } else { %>
            <span class="cg-need-lbl">Need</span>
            <span class="cg-need-num"><%= t.needed %></span>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<!-- ============ ADD COURSE ============ -->
<div class="cg-panel">
  <div class="cg-panel-head">
    <span class="cg-panel-icon">➕</span>
    <div>
      <h3>Add a Course</h3>
      <p>Enter past or expected grades to calculate your CGPA.</p>
    </div>
  </div>

  <form method="POST" action="/sis/my/cgpa/add" class="cg-form">
    <div class="cg-field cg-field-wide">
      <label class="cg-lbl">Course Name *</label>
      <input class="cg-input" type="text" name="course_name" required placeholder="e.g. Calculus I" maxlength="80">
    </div>

    <div class="cg-field">
      <label class="cg-lbl">Credits *</label>
      <input class="cg-input" type="number" name="credits" required min="0.5" max="12" step="0.5" value="3">
    </div>

    <div class="cg-field">
      <label class="cg-lbl">Grade *</label>
      <select class="cg-select" name="grade" required>
        <% gradeOptions.forEach(g => { %>
          <option value="<%= g %>"><%= g %> (<%= GPA_MAP ? '' : '' %>)</option>
        <% }) %>
      </select>
    </div>

    <div class="cg-field">
      <label class="cg-lbl">Semester</label>
      <input class="cg-input" type="text" name="semester" placeholder="e.g. Fall 2026" maxlength="40">
    </div>

    <div class="cg-form-actions">
      <button type="submit" class="cg-submit">💾 Add Course</button>
    </div>
  </form>
</div>

<!-- ============ SEMESTER BREAKDOWN ============ -->
<% if (semesterStats.length > 0) { %>
<div class="cg-panel">
  <div class="cg-panel-head">
    <span class="cg-panel-icon">📊</span>
    <div>
      <h3>Semester Breakdown</h3>
    </div>
  </div>

  <div class="cg-sem-grid">
    <% semesterStats.forEach(s => { %>
      <div class="cg-sem">
        <div class="cg-sem-name"><%= s.name %></div>
        <div class="cg-sem-gpa"><%= s.gpa %></div>
        <div class="cg-sem-meta"><%= s.credits %> credits · <%= s.count %> courses</div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<!-- ============ COURSE LIST ============ -->
<div class="cg-panel">
  <div class="cg-panel-head cg-panel-head-flex">
    <div style="display:flex;align-items:center;gap:.75rem;">
      <span class="cg-panel-icon">📚</span>
      <div>
        <h3>All Courses (<%= entries.length %>)</h3>
      </div>
    </div>
    <% if (entries.length > 0) { %>
      <form method="POST" action="/sis/my/cgpa/clear" onsubmit="return confirm('Clear ALL course entries? This cannot be undone.');">
        <button type="submit" class="cg-clear">🗑️ Clear All</button>
      </form>
    <% } %>
  </div>

  <% if (entries.length === 0) { %>
    <div class="sis-empty" style="padding:2rem;">
      No courses yet. Add your first one above to start calculating your CGPA.
    </div>
  <% } else { %>
    <div class="cg-list">
      <% entries.forEach(e => {
        const gpa = GPA_MAP[e.grade] || 0;
        const gradeClass =
          gpa >= 3.7 ? 'cg-g-a' :
          gpa >= 3.0 ? 'cg-g-b' :
          gpa >= 2.0 ? 'cg-g-c' :
          gpa >= 1.0 ? 'cg-g-d' : 'cg-g-f';
      %>
        <div class="cg-item">
          <div class="cg-item-grade <%= gradeClass %>"><%= e.grade %></div>
          <div class="cg-item-body">
            <div class="cg-item-name"><%= e.course_name %></div>
            <div class="cg-item-meta">
              <%= e.credits %> credit<%= Number(e.credits) === 1 ? '' : 's' %>
              <% if (e.semester) { %> · <%= e.semester %><% } %>
            </div>
          </div>
          <form method="POST" action="/sis/my/cgpa/delete/<%= e.id %>" class="cg-item-del-form" onsubmit="return confirm('Remove this course?');">
            <button type="submit" class="cg-item-del" title="Remove">✕</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Grade legend -->
<div class="cg-legend">
  <div class="cg-legend-title">Grade Scale</div>
  <div class="cg-legend-items">
    <span><b class="cg-g-a">A</b> 4.0</span>
    <span><b class="cg-g-b">B</b> 3.0</span>
    <span><b class="cg-g-c">C</b> 2.0</span>
    <span><b class="cg-g-d">D</b> 1.0</span>
    <span><b class="cg-g-f">F</b> 0.0</span>
  </div>
</div>

<style>
  /* ============ HERO ============ */
  .cg-hero {
    position: relative;
    background: linear-gradient(135deg, #0f2942 0%, #0891b2 100%);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: 0 12px 32px rgba(6,182,212,.25);
    color: #fff;
  }
  .cg-hero-glow {
    position: absolute; inset: 0;
    background-image:
      radial-gradient(circle at 15% 30%, rgba(103,232,249,.3) 0%, transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(6,182,212,.35) 0%, transparent 45%);
    pointer-events: none;
  }
  .cg-hero-main {
    position: relative;
    padding: 2rem 2rem 1.5rem;
    text-align: center;
  }
  .cg-hero-label {
    font-size: .68rem; text-transform: uppercase;
    letter-spacing: .18em; color: #67e8f9;
    font-weight: 800;
  }
  .cg-hero-num {
    font-family: Georgia, serif;
    font-size: 4rem; font-weight: 900;
    line-height: 1; letter-spacing: -.03em;
    margin: .35rem 0 .25rem;
    color: #fff;
  }
  .cg-hero-scale {
    color: rgba(255,255,255,.7);
    font-size: .82rem;
    font-weight: 600;
  }
  .cg-hero-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: rgba(0,0,0,.15);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255,255,255,.1);
  }
  .cg-hs {
    padding: .9rem;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.08);
  }
  .cg-hs:last-child { border-right: none; }
  .cg-hs-num {
    font-family: Georgia, serif;
    font-size: 1.4rem; font-weight: 800;
    color: #fff; line-height: 1;
  }
  .cg-hs-lbl {
    font-size: .6rem; text-transform: uppercase;
    letter-spacing: .14em; color: rgba(255,255,255,.7);
    font-weight: 800; margin-top: .35rem;
  }

  /* ============ PANEL ============ */
  .cg-panel {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
    margin-bottom: 1.25rem;
  }
  .cg-panel-head {
    display: flex; align-items: flex-start;
    gap: .85rem; margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .cg-panel-head-flex {
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: .75rem;
  }
  .cg-panel-icon { font-size: 1.4rem; flex-shrink: 0; }
  .cg-panel-head h3 {
    font-size: 1rem; font-weight: 800;
    color: #0f172a; letter-spacing: -.01em;
  }
  .cg-panel-head p {
    font-size: .82rem; color: #64748b;
    line-height: 1.5; margin-top: .2rem;
  }

  /* ============ TARGETS ============ */
  .cg-targets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: .75rem;
  }
  .cg-target {
    border-radius: 10px;
    padding: .9rem;
    text-align: center;
    border: 1.5px solid #e2e8f0;
    background: #f8fafc;
  }
  .cg-target-ok { background: #f0fdf4; border-color: #bbf7d0; }
  .cg-target-no { background: #fef2f2; border-color: #fecaca; }
  .cg-target-gpa-lbl {
    font-size: .6rem; text-transform: uppercase;
    letter-spacing: .12em; color: #94a3b8;
    font-weight: 800;
  }
  .cg-target-gpa-num {
    display: block;
    font-family: Georgia, serif;
    font-size: 1.35rem; font-weight: 800;
    color: #0f2942; margin: .15rem 0 .4rem;
  }
  .cg-target-need {
    font-size: .78rem;
    border-top: 1px solid rgba(0,0,0,.05);
    padding-top: .4rem;
    margin-top: .4rem;
  }
  .cg-need-lbl { color: #64748b; margin-right: .2rem; }
  .cg-need-num {
    font-family: ui-monospace, monospace;
    font-weight: 800; color: #0891b2;
  }
  .cg-need-yes { color: #059669; font-weight: 800; font-size: .78rem; }
  .cg-need-no  { color: #dc2626; font-weight: 800; font-size: .78rem; }

  /* ============ FORM ============ */
  .cg-form {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr auto;
    gap: .75rem;
    align-items: end;
  }
  .cg-field { display: flex; flex-direction: column; min-width: 0; }
  .cg-field-wide { grid-column: 1; }
  .cg-lbl {
    font-size: .68rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: .1em;
    color: #475569; margin-bottom: .4rem;
  }
  .cg-input, .cg-select {
    width: 100%; padding: .7rem .85rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 9px;
    background: #fff; font-size: .88rem;
    font-family: inherit; color: #0f172a;
    transition: all .15s;
  }
  .cg-input:focus, .cg-select:focus {
    outline: none; border-color: #06b6d4;
    box-shadow: 0 0 0 3px rgba(6,182,212,.15);
  }
  .cg-form-actions { display: flex; }
  .cg-submit {
    width: 100%;
    padding: .7rem 1.25rem;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    color: #fff; border: none; border-radius: 9px;
    font-size: .85rem; font-weight: 800;
    cursor: pointer; font-family: inherit;
    box-shadow: 0 6px 14px rgba(6,182,212,.3);
    transition: all .15s;
    white-space: nowrap;
  }
  .cg-submit:hover { transform: translateY(-2px); }

  .cg-clear {
    background: #fee2e2; color: #991b1b;
    border: none; padding: .5rem .9rem;
    border-radius: 8px; font-size: .76rem;
    font-weight: 800; cursor: pointer;
    font-family: inherit;
  }
  .cg-clear:hover { background: #fecaca; }

  /* ============ SEMESTER GRID ============ */
  .cg-sem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: .75rem;
  }
  .cg-sem {
    background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
    border: 1px solid #bae6fd;
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
  }
  .cg-sem-name {
    font-size: .72rem; text-transform: uppercase;
    letter-spacing: .1em; color: #0369a1;
    font-weight: 800;
    margin-bottom: .4rem;
    word-break: break-word;
  }
  .cg-sem-gpa {
    font-family: Georgia, serif;
    font-size: 1.9rem; font-weight: 900;
    color: #0891b2; line-height: 1;
  }
  .cg-sem-meta {
    font-size: .72rem; color: #475569;
    margin-top: .4rem; font-weight: 600;
  }

  /* ============ LIST ============ */
  .cg-list { display: flex; flex-direction: column; gap: .6rem; }
  .cg-item {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: .85rem;
    align-items: center;
    padding: .75rem .9rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    transition: all .15s;
  }
  .cg-item:hover { box-shadow: 0 3px 12px rgba(15,23,42,.06); }
  .cg-item-grade {
    width: 52px; height: 52px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 1.15rem;
    font-family: Georgia, serif;
    color: #fff;
    flex-shrink: 0;
  }
  .cg-g-a { background: linear-gradient(135deg, #10b981, #059669); }
  .cg-g-b { background: linear-gradient(135deg, #06b6d4, #0891b2); }
  .cg-g-c { background: linear-gradient(135deg, #f59e0b, #d97706); }
  .cg-g-d { background: linear-gradient(135deg, #f97316, #ea580c); }
  .cg-g-f { background: linear-gradient(135deg, #ef4444, #dc2626); }

  .cg-item-body { min-width: 0; }
  .cg-item-name {
    font-weight: 800; color: #0f172a;
    font-size: .93rem;
    word-break: break-word;
    line-height: 1.3;
  }
  .cg-item-meta {
    color: #64748b; font-size: .78rem;
    margin-top: .2rem;
  }
  .cg-item-del-form { display: flex; }
  .cg-item-del {
    background: #fef2f2; color: #991b1b;
    border: none; width: 32px; height: 32px;
    border-radius: 8px; font-size: .85rem;
    font-weight: 800; cursor: pointer;
    font-family: inherit;
    transition: all .15s;
  }
  .cg-item-del:hover { background: #fecaca; }

  /* ============ LEGEND ============ */
  .cg-legend {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }
  .cg-legend-title {
    font-size: .65rem; text-transform: uppercase;
    letter-spacing: .14em; color: #94a3b8;
    font-weight: 800; margin-bottom: .6rem;
  }
  .cg-legend-items {
    display: flex; flex-wrap: wrap; gap: .75rem 1.25rem;
    font-size: .8rem; color: #475569;
  }
  .cg-legend-items b {
    display: inline-flex;
    align-items: center; justify-content: center;
    width: 26px; height: 26px;
    border-radius: 6px;
    color: #fff;
    font-family: Georgia, serif;
    font-weight: 900;
    margin-right: .35rem;
    font-size: .8rem;
  }

  /* ============ MOBILE ============ */
  @media (max-width: 800px) {
    .cg-hero-main { padding: 1.5rem 1.25rem 1.25rem; }
    .cg-hero-num { font-size: 3rem; }
    .cg-hs { padding: .75rem .35rem; }
    .cg-hs-num { font-size: 1.2rem; }
    .cg-hs-lbl { font-size: .55rem; }

    .cg-panel { padding: 1.15rem; }

    .cg-form { grid-template-columns: 1fr 1fr; gap: .75rem; }
    .cg-field-wide { grid-column: 1 / -1; }
    .cg-form-actions { grid-column: 1 / -1; }

    .cg-targets { grid-template-columns: repeat(2, 1fr); }

    .cg-item { grid-template-columns: 46px 1fr auto; gap: .65rem; padding: .65rem .75rem; }
    .cg-item-grade { width: 46px; height: 46px; font-size: 1rem; }
    .cg-item-name { font-size: .86rem; }
  }

  @media (max-width: 420px) {
    .cg-form { grid-template-columns: 1fr; }
    .cg-targets { grid-template-columns: 1fr; }
  }
</style>

<%- include('partials/foot') %>