        <div style="text-align:right;">
          <div class="sis-user-name"><%= user.full_name || user.username %></div>
          <div class="sis-user-role"><%= user.role %></div>
        </div>
        <div style="width:38px;height:38px;background:linear-gradient(135deg,#06b6d4,#0891b2);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.95rem;">
          <%= (user.full_name || user.username).charAt(0).toUpperCase() %>
        </div>
      </div>
    </div>

    <% if (flash.error && flash.error.length) { %>
      <div class="sis-flash sis-flash-error">⚠️ <%= flash.error[0] %></div>
    <% } %>
    <% if (flash.success && flash.success.length) { %>
      <div class="sis-flash sis-flash-success">✓ <%= flash.success[0] %></div>
    <% } %>

    <script>
      (function () {
        var btn = document.getElementById('sisMenuBtn');
        var sidebar = document.getElementById('sisSidebar');
        var backdrop = document.getElementById('sisBackdrop');
        if (!btn || !sidebar || !backdrop) return;

        function open() {
          sidebar.classList.add('open');
          backdrop.classList.add('show');
          document.body.style.overflow = 'hidden';
        }
        function close() {
          sidebar.classList.remove('open');
          backdrop.classList.remove('show');
          document.body.style.overflow = '';
        }

        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (sidebar.classList.contains('open')) close(); else open();
        });
        backdrop.addEventListener('click', close);

        sidebar.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            if (window.innerWidth <= 900) close();
          });
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
      })();
    </script>