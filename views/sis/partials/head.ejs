<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' · LuxMind SIS' : 'LuxMind SIS' %></title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', -apple-system, system-ui, sans-serif; }
  html, body { height: 100%; background: #f1f5f9; color: #0f172a; }

  .sis-shell { display: grid; grid-template-columns: 280px 1fr; min-height: 100vh; }

  .sis-sidebar {
    background: linear-gradient(180deg, #0f2942 0%, #051b30 100%);
    color: #cbd5e1; display: flex; flex-direction: column;
    padding: 1.25rem 0; overflow-y: auto;
    max-height: 100vh; position: sticky; top: 0;
  }
  .sis-brand {
    padding: 0 1.25rem 1.25rem;
    border-bottom: 1px solid rgba(148,163,184,.15);
    margin-bottom: .75rem; display: flex; align-items: center; gap: .75rem;
  }
  .sis-brand-logo {
    width: 42px; height: 42px;
    background: linear-gradient(135deg, #06b6d4, #0891b2);
    border-radius: 10px; display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 1.15rem; color: #051b30;
    box-shadow: 0 4px 12px rgba(6,182,212,.4);
  }
  .sis-brand-text { line-height: 1.1; }
  .sis-brand-title { font-weight: 800; font-size: 1rem; color: #fff; letter-spacing: -.01em; }
  .sis-brand-sub { font-size: .65rem; text-transform: uppercase; letter-spacing: .18em; color: #06b6d4; margin-top: 3px; font-weight: 700; }

  .sis-sidebar details { border: none; }
  .sis-sidebar details > summary {
    list-style: none; cursor: pointer; padding: .7rem 1.25rem;
    font-size: .7rem; text-transform: uppercase; letter-spacing: .14em;
    color: #94a3b8; font-weight: 700;
    display: flex; justify-content: space-between; align-items: center;
    transition: color .15s;
  }
  .sis-sidebar details > summary:hover { color: #06b6d4; }
  .sis-sidebar details > summary::-webkit-details-marker { display: none; }
  .sis-sidebar details > summary::after {
    content: '▾'; font-size: .8rem; transition: transform .2s;
  }
  .sis-sidebar details[open] > summary::after { transform: rotate(180deg); }

  .sis-nav-label {
    padding: .9rem 1.25rem .4rem;
    font-size: .68rem; text-transform: uppercase; letter-spacing: .16em;
    color: #64748b; font-weight: 800;
  }
  .sis-nav { display: flex; flex-direction: column; }
  .sis-nav a {
    display: flex; align-items: center; gap: .75rem;
    padding: .6rem 1.25rem .6rem 1.75rem;
    color: #cbd5e1; text-decoration: none; font-size: .87rem;
    border-left: 3px solid transparent; transition: all .15s;
  }
  .sis-nav a:hover { background: rgba(6,182,212,.08); color: #67e8f9; }
  .sis-nav a.active {
    background: rgba(6,182,212,.12); color: #67e8f9;
    border-left-color: #06b6d4; font-weight: 600;
  }
  .sis-nav a .icon { font-size: 1rem; width: 20px; text-align: center; }
  .sis-sidebar details details { margin-left: .5rem; border-left: 1px solid rgba(148,163,184,.15); }
  .sis-sidebar details details > summary { padding-left: 1.5rem; font-size: .72rem; }

  .sis-nav-single {
    display: flex; align-items: center; gap: .75rem;
    padding: .7rem 1.25rem; color: #cbd5e1; text-decoration: none;
    font-size: .9rem; border-left: 3px solid transparent; transition: all .15s;
  }
  .sis-nav-single:hover { background: rgba(6,182,212,.08); color: #67e8f9; }
  .sis-nav-single.active {
    background: rgba(6,182,212,.12); color: #67e8f9;
    border-left-color: #06b6d4; font-weight: 600;
  }

  .sis-back {
    margin-top: auto; padding: 1.25rem;
    border-top: 1px solid rgba(148,163,184,.15);
    display: flex; flex-direction: column; gap: .5rem;
  }
  .sis-back a {
    display: flex; align-items: center; gap: .5rem;
    color: #94a3b8; text-decoration: none; font-size: .84rem;
    padding: .6rem .8rem; border-radius: 6px;
  }
  .sis-back a:hover { background: rgba(6,182,212,.1); color: #67e8f9; }

  .sis-main { padding: 2rem 2.5rem; overflow-x: hidden; }
  .sis-topbar {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1.5rem; padding-bottom: 1.5rem;
    border-bottom: 2px solid #e2e8f0;
  }
  .sis-page-title { font-size: 1.75rem; font-weight: 800; color: #0f172a; letter-spacing: -.02em; }
  .sis-page-sub { color: #64748b; font-size: .9rem; margin-top: .35rem; }

  .sis-user {
    display: flex; align-items: center; gap: .75rem;
    padding: .5rem .9rem; background: #fff;
    border: 1px solid #e2e8f0; border-radius: 10px;
  }
  .sis-user-name { font-weight: 700; font-size: .88rem; }
  .sis-user-role { font-size: .72rem; color: #0891b2; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }

  .sis-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 1.5rem; margin-bottom: 1.5rem;
    box-shadow: 0 1px 3px rgba(15,23,42,.04);
  }
  .sis-card h2, .sis-card h3 {
    font-size: 1.05rem; color: #0f172a;
    margin-bottom: 1rem; padding-bottom: .65rem;
    border-bottom: 1px solid #f1f5f9; font-weight: 700;
    display: flex; align-items: center; gap: .5rem;
  }

  .sis-stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .sis-stat {
    background: #fff; border: 1px solid #e2e8f0;
    border-left: 4px solid #06b6d4;
    border-radius: 10px; padding: 1.25rem;
  }
  .sis-stat.gold   { border-left-color: #06b6d4; }
  .sis-stat.green  { border-left-color: #10b981; }
  .sis-stat.red    { border-left-color: #ef4444; }
  .sis-stat.slate  { border-left-color: #64748b; }
  .sis-stat-num { font-size: 2rem; font-weight: 800; color: #0f172a; line-height: 1; }
  .sis-stat-lbl { font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: #64748b; margin-top: .5rem; font-weight: 700; }

  .sis-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
  .sis-tile {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 1.75rem 1.25rem; text-align: center; text-decoration: none;
    transition: all .2s; cursor: pointer; display: block; color: #0f172a;
    box-shadow: 0 2px 8px rgba(15,23,42,.04);
  }
  .sis-tile:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(15,23,42,.15); }
  .sis-tile-icon { font-size: 2.8rem; margin-bottom: .85rem; display: block; line-height: 1; }
  .sis-tile-label { font-weight: 800; font-size: 1rem; letter-spacing: -.01em; }
  .sis-tile-sub { font-size: .75rem; opacity: .85; margin-top: .3rem; font-weight: 500; }

  .sis-tile.tile-blue    { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; border-color: transparent; }
  .sis-tile.tile-blue:hover    { box-shadow: 0 16px 32px rgba(59,130,246,.4); }
  .sis-tile.tile-green   { background: linear-gradient(135deg, #10b981, #059669); color: #fff; border-color: transparent; }
  .sis-tile.tile-green:hover   { box-shadow: 0 16px 32px rgba(16,185,129,.4); }
  .sis-tile.tile-amber   { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border-color: transparent; }
  .sis-tile.tile-amber:hover   { box-shadow: 0 16px 32px rgba(245,158,11,.4); }
  .sis-tile.tile-purple  { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; border-color: transparent; }
  .sis-tile.tile-purple:hover  { box-shadow: 0 16px 32px rgba(139,92,246,.4); }
  .sis-tile.tile-pink    { background: linear-gradient(135deg, #ec4899, #db2777); color: #fff; border-color: transparent; }
  .sis-tile.tile-pink:hover    { box-shadow: 0 16px 32px rgba(236,72,153,.4); }
  .sis-tile.tile-cyan    { background: linear-gradient(135deg, #06b6d4, #0891b2); color: #fff; border-color: transparent; }
  .sis-tile.tile-cyan:hover    { box-shadow: 0 16px 32px rgba(6,182,212,.4); }
  .sis-tile.tile-indigo  { background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; border-color: transparent; }
  .sis-tile.tile-indigo:hover  { box-shadow: 0 16px 32px rgba(99,102,241,.4); }
  .sis-tile.tile-rose    { background: linear-gradient(135deg, #f43f5e, #e11d48); color: #fff; border-color: transparent; }
  .sis-tile.tile-rose:hover    { box-shadow: 0 16px 32px rgba(244,63,94,.4); }
  .sis-tile.tile-slate   { background: linear-gradient(135deg, #64748b, #475569); color: #fff; border-color: transparent; }
  .sis-tile.tile-slate:hover   { box-shadow: 0 16px 32px rgba(100,116,139,.4); }

  .sis-table { width: 100%; border-collapse: collapse; background: #fff; }
  .sis-table thead { background: #f8fafc; }
  .sis-table th {
    text-align: left; padding: .85rem 1rem;
    font-size: .7rem; text-transform: uppercase; letter-spacing: .1em;
    color: #64748b; font-weight: 800; border-bottom: 2px solid #e2e8f0;
  }
  .sis-table td { padding: .9rem 1rem; border-bottom: 1px solid #f1f5f9; font-size: .9rem; }
  .sis-table tr:hover { background: #f8fafc; }

  .sis-badge {
    display: inline-block; padding: 3px 10px; font-size: .7rem;
    font-weight: 800; text-transform: uppercase; letter-spacing: .06em;
    border-radius: 100px;
  }
  .sis-badge-active  { background: #d1fae5; color: #065f46; }
  .sis-badge-inactive{ background: #fee2e2; color: #991b1b; }
  .sis-badge-gold    { background: #cffafe; color: #0e7490; }

  .sis-btn {
    display: inline-block; padding: .65rem 1.2rem;
    background: #0f2942; color: #67e8f9;
    text-decoration: none; border: none; border-radius: 8px;
    font-size: .85rem; font-weight: 700; cursor: pointer;
    letter-spacing: .02em; transition: all .15s; font-family: inherit;
  }
  .sis-btn:hover { background: #051b30; }
  .sis-btn-gold { background: linear-gradient(135deg, #06b6d4, #0891b2); color: #fff; }
  .sis-btn-gold:hover { background: linear-gradient(135deg, #0891b2, #0e7490); }
  .sis-btn-outline { background: #fff; color: #0f2942; border: 1px solid #e2e8f0; }
  .sis-btn-outline:hover { background: #f1f5f9; border-color: #06b6d4; }

  .sis-input, .sis-select, .sis-textarea {
    width: 100%; padding: .7rem .9rem;
    border: 1px solid #cbd5e1; border-radius: 8px;
    background: #fff; font-size: .9rem; font-family: inherit; color: #0f172a;
  }
  .sis-input:focus, .sis-select:focus, .sis-textarea:focus {
    outline: none; border-color: #06b6d4; box-shadow: 0 0 0 3px rgba(6,182,212,.15);
  }
  .sis-label { display: block; font-size: .78rem; font-weight: 700; color: #334155; margin-bottom: .4rem; }

  .sis-flash {
    padding: .9rem 1.2rem; border-radius: 8px;
    margin-bottom: 1.5rem; font-size: .9rem; border-left: 4px solid;
  }
  .sis-flash-success { background: #d1fae5; color: #065f46; border-color: #10b981; }
  .sis-flash-error   { background: #fee2e2; color: #991b1b; border-color: #ef4444; }

  .sis-empty {
    text-align: center; padding: 3rem 1rem; color: #64748b;
    background: #fff; border: 1px dashed #cbd5e1; border-radius: 10px; font-size: .92rem;
  }

  .sis-moodle-btn {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .4rem .75rem; background: linear-gradient(135deg,#10b981,#059669);
    color: #fff; text-decoration: none; border-radius: 6px;
    font-size: .78rem; font-weight: 700;
  }
  .sis-moodle-btn:hover { opacity: .9; }

  .sis-welcome {
    background: linear-gradient(135deg, #0f2942 0%, #0891b2 100%);
    color: #fff; padding: 2rem 2.25rem; border-radius: 14px;
    margin-bottom: 2rem; box-shadow: 0 12px 32px rgba(6,182,212,.25);
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
  }
  .sis-welcome-greeting { font-size: 1.75rem; font-weight: 800; letter-spacing: -.02em; }
  .sis-welcome-date { font-size: .92rem; opacity: .85; margin-top: .35rem; }
  .sis-welcome-user { text-align: right; font-size: .85rem; opacity: .9; }
  .sis-welcome-user strong { display: block; font-size: 1rem; margin-bottom: .15rem; }

  img, table, pre { max-width: 100%; }
  .sis-main, .sis-card, .sis-stat, .sis-tile { min-width: 0; }
  .sis-page-title, .sis-card h3, .sis-tile-label {
    overflow-wrap: break-word; word-wrap: break-word; hyphens: auto;
  }
  .sis-table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .sis-table thead, .sis-table tbody { display: table; width: 100%; min-width: 600px; }

  .sis-hamburger {
    display: none;
    position: fixed; top: 1rem; left: 1rem; z-index: 200;
    background: linear-gradient(135deg, #0f2942, #0891b2);
    color: #fff; border: none;
    width: 44px; height: 44px; border-radius: 10px;
    font-size: 1.4rem; cursor: pointer;
    box-shadow: 0 6px 18px rgba(6,182,212,.35);
    align-items: center; justify-content: center; font-family: inherit;
  }
  .sis-hamburger:active { transform: scale(.95); }

  .sis-backdrop {
    display: none; position: fixed; inset: 0;
    background: rgba(15,23,42,.5); z-index: 99;
    backdrop-filter: blur(2px);
  }
  .sis-backdrop.show { display: block; }

  @media (max-width: 900px) {
    .sis-shell { grid-template-columns: 1fr; }
    .sis-hamburger { display: flex; }
    .sis-sidebar {
      position: fixed; top: 0; left: 0;
      width: 280px; max-width: 85vw; height: 100vh;
      z-index: 100; transform: translateX(-100%);
      transition: transform .25s cubic-bezier(.4,0,.2,1);
      box-shadow: 4px 0 24px rgba(0,0,0,.15);
    }
    .sis-sidebar.open { transform: translateX(0); }
    .sis-main { padding: 4.5rem 1rem 1.5rem; overflow-x: hidden; }
    .sis-topbar { flex-direction: column; align-items: flex-start; gap: .75rem; }
    .sis-user { width: 100%; justify-content: space-between; }
    .sis-stat-grid { grid-template-columns: repeat(2, 1fr); gap: .75rem; }
    .sis-stat { padding: 1rem; }
    .sis-stat-num { font-size: 1.5rem; }
    .sis-stat-lbl { font-size: .65rem; }
    .sis-tiles { grid-template-columns: repeat(2, 1fr); gap: .75rem; }
    .sis-tile { padding: 1.25rem .75rem; }
    .sis-tile-icon { font-size: 2.2rem; margin-bottom: .55rem; }
    .sis-tile-label { font-size: .85rem; }
    .sis-tile-sub { font-size: .68rem; }
    .sis-card { padding: 1.1rem; margin-bottom: 1rem; }
    .sis-card h3 { font-size: .98rem; }
    .sis-page-title { font-size: 1.4rem; }
    .sis-page-sub { font-size: .82rem; }
    .sis-btn { padding: .55rem 1rem; font-size: .82rem; }
    .sis-input, .sis-select, .sis-textarea { font-size: 16px; padding: .7rem .8rem; }
  }

  @media (max-width: 400px) {
    .sis-stat-grid { grid-template-columns: 1fr; }
    .sis-tiles { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<div class="sis-shell">

  <button class="sis-hamburger" id="sisMenuBtn" aria-label="Open menu">☰</button>
  <div class="sis-backdrop" id="sisBackdrop"></div>

  <aside class="sis-sidebar" id="sisSidebar">
    <div class="sis-brand">
      <div class="sis-brand-logo">S</div>
      <div class="sis-brand-text">
        <div class="sis-brand-title">LuxMind SIS</div>
        <div class="sis-brand-sub">
          <%= user && user.role === 'admin' ? 'Admin Portal' : (user && user.role === 'teacher' ? 'Faculty Portal' : 'Student Portal') %>
        </div>
      </div>
    </div>

    <% if (user && user.role === 'admin') { %>
      <div class="sis-nav-label">Administration</div>
      <nav class="sis-nav">
        <a href="/sis/admin" class="<%= currentPath === '/sis/admin' || currentPath === '/sis' ? 'active' : '' %>"><span class="icon">🏛️</span> Overview</a>
        <a href="/sis/students" class="<%= currentPath && currentPath.startsWith('/sis/students') && !currentPath.includes('/new') ? 'active' : '' %>"><span class="icon">🎓</span> Students</a>
        <a href="/sis/attendance" class="<%= currentPath && currentPath.startsWith('/sis/attendance') ? 'active' : '' %>"><span class="icon">📅</span> Attendance</a>
      </nav>

      <details open>
        <summary>Registry</summary>
        <nav class="sis-nav">
          <a href="/sis/students/new"><span class="icon">➕</span> Register Student</a>
          <a href="/sis/admin/registrations" class="<%= currentPath === '/sis/admin/registrations' ? 'active' : '' %>"><span class="icon">📝</span> Course Registrations</a>
          <a href="/sis/admin/withdrawals" class="<%= currentPath === '/sis/admin/withdrawals' ? 'active' : '' %>"><span class="icon">🚪</span> Course Withdrawals</a>
          <a href="/sis/admin/documents" class="<%= currentPath === '/sis/admin/documents' ? 'active' : '' %>"><span class="icon">📄</span> Document Requests</a>
          <a href="/sis/admin/classes" class="<%= currentPath && currentPath.startsWith('/sis/admin/classes') ? 'active' : '' %>"><span class="icon">🏫</span> Classes</a>
          <a href="/sis/admin/course-teachers" class="<%= currentPath === '/sis/admin/course-teachers' ? 'active' : '' %>"><span class="icon">👨‍🏫</span> Course Teachers</a>
                    <a href="/sis/admin/curriculum" class="<%= currentPath === '/sis/admin/curriculum' ? 'active' : '' %>"><span class="icon">📖</span> Curriculum</a>
          <a href="/sis/admin/exams" class="<%= currentPath && currentPath.startsWith('/sis/admin/exams') ? 'active' : '' %>"><span class="icon">📝</span> Exams</a>
        </nav>
      </details>

            <details>
        <summary>Finance</summary>
        <nav class="sis-nav">
          <a href="/sis/admin/fees" class="<%= currentPath === '/sis/admin/fees' ? 'active' : '' %>"><span class="icon">📋</span> Fee Structure</a>
          <a href="/sis/admin/fees/payments" class="<%= currentPath === '/sis/admin/fees/payments' ? 'active' : '' %>"><span class="icon">💳</span> Record Payment</a>
          <a href="/sis/admin/fees/balances" class="<%= currentPath === '/sis/admin/fees/balances' ? 'active' : '' %>"><span class="icon">📊</span> Student Balances</a>
        </nav>
      </details>

      <details>
        <summary>Communication</summary>
        <nav class="sis-nav">
          <a href="https://luxmind.onrender.com/messages"><span class="icon">💬</span> Messages</a>
          <a href="https://luxmind.onrender.com/notifications"><span class="icon">🔔</span> Notifications</a>
        </nav>
      </details>

    <% } else if (user && user.role === 'teacher') { %>
      <div class="sis-nav-label">Faculty</div>
      <nav class="sis-nav">
        <a href="/sis/faculty" class="<%= currentPath === '/sis/faculty' ? 'active' : '' %>"><span class="icon">🏛️</span> Dashboard</a>
        <a href="/sis/attendance" class="<%= currentPath && currentPath.startsWith('/sis/attendance') ? 'active' : '' %>"><span class="icon">📅</span> Take Attendance</a>
      </nav>

      <details open>
        <summary>🏫 My Classes</summary>
        <nav class="sis-nav">
          <a href="/sis/admin/classes" class="<%= currentPath && currentPath.startsWith('/sis/admin/classes') ? 'active' : '' %>"><span class="icon">🏫</span> My Classes</a>
          <a href="/sis/admin/exams" class="<%= currentPath && currentPath.startsWith('/sis/admin/exams') ? 'active' : '' %>"><span class="icon">📝</span> My Exams</a>
        </nav>
      </details>

      <details>
        <summary>Attendance</summary>
        <nav class="sis-nav">
          <a href="/sis/attendance"><span class="icon">✅</span> Mark Today</a>
          <a href="/sis/attendance?date=&class="><span class="icon">📋</span> History</a>
        </nav>
      </details>

      <details>
        <summary>Communication</summary>
        <nav class="sis-nav">
          <a href="https://luxmind.onrender.com/teacher/announcements"><span class="icon">📢</span> Announcements</a>
          <a href="https://luxmind.onrender.com/messages"><span class="icon">💬</span> Messages</a>
          <a href="https://luxmind.onrender.com/notifications"><span class="icon">🔔</span> Notifications</a>
        </nav>
      </details>

    <% } else if (user && user.role === 'student') { %>
      <div class="sis-nav-label">Student</div>

      <a href="/sis/my" class="sis-nav-single <%= currentPath === '/sis/my' ? 'active' : '' %>">
        <span class="icon">🏛️</span> Dashboard
      </a>

      <details open>
        <summary>📚 Course</summary>
        <nav class="sis-nav">
          <a href="/sis/my/timetable" class="<%= currentPath === '/sis/my/timetable' ? 'active' : '' %>"><span class="icon">📅</span> Timetable</a>
          <a href="/sis/my/attendance" class="<%= currentPath === '/sis/my/attendance' ? 'active' : '' %>"><span class="icon">📋</span> Attendance Detail</a>
          <a href="/sis/my/grades" class="<%= currentPath === '/sis/my/grades' ? 'active' : '' %>"><span class="icon">🏆</span> My Grades</a>
          <a href="/sis/my/registration" class="<%= currentPath === '/sis/my/registration' ? 'active' : '' %>"><span class="icon">📝</span> Course Registration</a>
          <a href="/sis/my/withdrawal" class="<%= currentPath === '/sis/my/withdrawal' ? 'active' : '' %>"><span class="icon">🚪</span> Course Withdrawal</a>
