<%- include('../partials/head', { 
  title: course.title + ' — Forum',
  heading: course.title + ' — Forum',
  subtitle: 'Ask questions, share ideas, help each other.'
}) %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;gap:.6rem;">
  <div>
    <span class="badge info"><%= threads.length %> thread<%= threads.length === 1 ? '' : 's' %></span>
  </div>
  <div style="display:flex;gap:.5rem;">
    <a class="btn outline" href="/courses/<%= course.id %>">← Course</a>
    <a class="btn" href="/forums/<%= course.id %>/new">+ New Thread</a>
  </div>
</div>

<% if (threads.length === 0) { %>
  <div class="empty">
    <div style="font-size:3rem;margin-bottom:.75rem;">💬</div>
    <div style="font-weight:700;color:#0f172a;font-size:1.1rem;margin-bottom:.3rem;">No threads yet</div>
    <p>Be the first to start a discussion.</p>
  </div>
<% } else { %>
  <% threads.forEach(t => {
       const roleBadge = t.author_role === 'admin' ? 'err' : t.author_role === 'teacher' ? 'purple' : 'info';
  %>
    <a href="/forums/thread/<%= t.id %>" style="text-decoration:none;color:inherit;">
      <div class="card animate" style="margin-bottom:.85rem;border-left:4px solid #6366f1;transition:all .15s;" onmouseover="this.style.transform='translateX(4px)'" onmouseout="this.style.transform='translateX(0)'">
        <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:240px;">
            <div style="display:flex;gap:.5rem;align-items:center;margin-bottom:.4rem;flex-wrap:wrap;">
              <span class="badge <%= roleBadge %>"><%= t.author_name || t.author_username %></span>
              <span class="muted" style="font-size:.75rem;"><%= new Date(t.created_at).toLocaleDateString() %></span>
            </div>
            <div style="font-weight:700;color:#0f172a;font-size:1.05rem;"><%= t.title %></div>
            <div class="muted" style="margin-top:.35rem;font-size:.88rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
              <%= t.body %>
            </div>
          </div>
          <div style="text-align:right;flex-shrink:0;">
            <div style="font-size:1.4rem;font-weight:800;color:#6366f1;"><%= t.reply_count %></div>
            <div class="muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">
              repl<%= t.reply_count === 1 ? 'y' : 'ies' %>
            </div>
          </div>
        </div>
      </div>
    </a>
  <% }) %>
<% } %>

<%- include('../partials/foot') %>