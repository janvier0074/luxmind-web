<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>500 · LuxMind</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; background: radial-gradient(circle at 30% 20%, #450a0a 0%, #0f172a 80%); color:#fff; margin:0; font-family:system-ui, sans-serif; }
    .wrap { text-align:center; padding:2rem; max-width:520px; }
    .big { font-size:8rem; font-weight:900; background:linear-gradient(135deg,#ef4444,#f59e0b); -webkit-background-clip:text; -webkit-text-fill-color:transparent; line-height:1; letter-spacing:-.05em; }
    h1 { font-size:1.5rem; font-weight:700; margin-top:1rem; }
    p { color:#94a3b8; margin-top:.6rem; line-height:1.6; }
    .btn { display:inline-block; margin-top:2rem; padding:.85rem 1.8rem; background:linear-gradient(135deg,#ef4444,#f59e0b); color:#fff; text-decoration:none; border-radius:12px; font-weight:700; box-shadow:0 10px 28px rgba(239,68,68,.4); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="big">500</div>
    <h1>Something went wrong</h1>
      <p>The server hit an unexpected error. Please try again in a moment.</p>
    <% if (typeof showDetail !== 'undefined' && showDetail && typeof detail !== 'undefined') { %>
      <div style="margin-top:1.5rem;padding:1rem;background:rgba(255,255,255,.08);border-radius:12px;font-family:ui-monospace,monospace;font-size:.82rem;color:#fca5a5;text-align:left;word-break:break-word;">
        <%= detail %>
      </div>
    <% } %>
    <a class="btn" href="/dashboard">← Back to Dashboard</a>



</body>
</html>