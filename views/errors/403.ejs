<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>403 · LuxMind</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; background: radial-gradient(circle at 30% 20%, #4c1d95 0%, #0f172a 80%); color:#fff; margin:0; font-family:system-ui, sans-serif; }
    .wrap { text-align:center; padding:2rem; max-width:520px; }
    .big { font-size:8rem; font-weight:900; background:linear-gradient(135deg,#f43f5e,#ec4899); -webkit-background-clip:text; -webkit-text-fill-color:transparent; line-height:1; letter-spacing:-.05em; }
    h1 { font-size:1.5rem; font-weight:700; margin-top:1rem; }
    p { color:#94a3b8; margin-top:.6rem; line-height:1.6; }
    .btn { display:inline-block; margin-top:2rem; padding:.85rem 1.8rem; background:linear-gradient(135deg,#ec4899,#f43f5e); color:#fff; text-decoration:none; border-radius:12px; font-weight:700; box-shadow:0 10px 28px rgba(236,72,153,.4); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="big">403</div>
    <h1>Access denied</h1>
    <p>You don't have permission to view this page. Please contact your administrator if you think this is a mistake.</p>
    <a class="btn" href="/dashboard">← Back to Dashboard</a>
  </div>
</body>
</html>