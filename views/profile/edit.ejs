<%- include('../partials/head', { 
  title: 'Edit Profile',
  heading: 'Edit Profile',
  subtitle: 'Update your personal information.'
}) %>

<div class="card animate" style="max-width:720px;">
  <form method="POST" action="/profile/edit" enctype="multipart/form-data">

    <div style="display:flex;gap:1.5rem;align-items:center;margin-bottom:1.8rem;">
      <div style="width:90px;height:90px;border-radius:50%;overflow:hidden;box-shadow:0 8px 24px rgba(99,102,241,.25);flex-shrink:0;">
        <% if (profile.avatar_path) { %>
          <img src="<%= profile.avatar_path %>" style="width:100%;height:100%;object-fit:cover;">
        <% } else { %>
          <div style="width:100%;height:100%;background:linear-gradient(135deg,#6366f1,#ec4899);display:flex;align-items:center;justify-content:center;color:#fff;font-size:2.2rem;font-weight:800;">
            <%= (profile.full_name || profile.username).charAt(0).toUpperCase() %>
          </div>
        <% } %>
      </div>
      <div>
        <label style="display:block;font-weight:700;margin-bottom:.4rem;color:#334155;">Profile photo</label>
        <input type="file" name="avatar" accept="image/*" style="font-size:.9rem;">
        <p class="muted" style="margin-top:.4rem;">Max 3MB · JPG, PNG, GIF, WEBP</p>
      </div>
    </div>

    <label style="display:block;font-weight:700;margin-bottom:.4rem;color:#334155;">Full name</label>
    <input name="full_name" value="<%= profile.full_name || '' %>"
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;margin-bottom:1.2rem;background:#f8fafc;">

    <label style="display:block;font-weight:700;margin-bottom:.4rem;color:#334155;">Email</label>
    <input name="email" type="email" value="<%= profile.email || '' %>"
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;margin-bottom:1.2rem;background:#f8fafc;">

    <label style="display:block;font-weight:700;margin-bottom:.4rem;color:#334155;">Bio</label>
    <textarea name="bio" rows="4" placeholder="Tell us about yourself..."
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;margin-bottom:1.5rem;background:#f8fafc;font-family:inherit;resize:vertical;"><%= profile.bio || '' %></textarea>

    <div style="display:flex;gap:.6rem;">
      <button class="btn" type="submit">💾 Save Changes</button>
      <a class="btn outline" href="/profile">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>