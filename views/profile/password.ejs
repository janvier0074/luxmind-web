<%- include('../partials/head', { 
  title: 'Change Password',
  heading: 'Change Password',
  subtitle: 'Keep your account secure.'
}) %>

<div class="card animate" style="max-width:520px;">
  <form method="POST" action="/profile/password">
    <label style="display:block;font-weight:700;margin-bottom:.4rem;color:#334155;">Current password</label>
    <input name="current" type="password" required
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;margin-bottom:1.2rem;background:#f8fafc;">

    <label style="display:block;font-weight:700;margin-bottom:.4rem;color:#334155;">New password</label>
    <input name="next" type="password" required minlength="6"
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;margin-bottom:1.2rem;background:#f8fafc;">

    <label style="display:block;font-weight:700;margin-bottom:.4rem;color:#334155;">Confirm new password</label>
    <input name="confirm" type="password" required minlength="6"
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;margin-bottom:1.5rem;background:#f8fafc;">

    <div style="display:flex;gap:.6rem;">
      <button class="btn" type="submit">🔒 Update Password</button>
      <a class="btn outline" href="/profile">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>