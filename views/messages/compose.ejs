<%- include('../partials/head', { 
  title: 'New Message',
  heading: 'New Message',
  subtitle: 'Send a private message.'
}) %>

<div class="card animate" style="max-width:640px;">
  <form method="POST" action="/messages/new">
    <label style="display:block;font-weight:600;color:#334155;margin-bottom:.4rem;">Recipient</label>
    <select name="receiver_id" required
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;background:#f8fafc;font-size:.95rem;margin-bottom:1.2rem;">
      <option value="">Choose someone</option>
      <% recipients.forEach(r => { %>
        <option value="<%= r.id %>" <%= preset === r.id ? 'selected' : '' %>>
          <%= r.full_name || r.username %> (<%= r.role %>)
        </option>
      <% }) %>
    </select>

    <label style="display:block;font-weight:600;color:#334155;margin-bottom:.4rem;">Message</label>
    <textarea name="body" rows="6" required placeholder="Write your message..."
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;background:#f8fafc;font-size:.95rem;font-family:inherit;resize:vertical;margin-bottom:1.2rem;"></textarea>

    <div style="display:flex;gap:.6rem;">
      <button class="btn" type="submit">📨 Send Message</button>
      <a class="btn outline" href="/messages">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>