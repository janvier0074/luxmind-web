<%- include('../partials/head', { 
  title: 'Dashboard',
  heading: heading,
  subtitle: subtitle
}) %>

<style>
  /* ===== HERO CARD ===== */
  .dash-hero {
    position: relative;
    border-radius: 24px;
    padding: 2.25rem 2.5rem;
    color: #fff;
    overflow: hidden;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 45%, #ec4899 100%);
    box-shadow: 0 24px 60px rgba(99,102,241,.35);
    display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .dash-hero::before {
    content: ''; position: absolute; right: -80px; top: -80px;
    width: 300px; height: 300px; border-radius: 50%;
    background: rgba(255,255,255,.1);
  }
  .dash-hero::after {
    content: ''; position: absolute; left: 40%; bottom: -100px;
    width: 240px; height: 240px; border-radius: 50%;
    background: rgba(255,255,255,.07);
  }
  .dash-hero > * { position: relative; z-index: 1; }

  .ring-large {
    width: 140px; height: 140px;
    position: relative; flex-shrink: 0;
  }
  .ring-large svg { transform: rotate(-90deg); }
  .ring-large .ring-inner {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .ring-large .pct { font-size: 2rem; font-weight: 900; letter-spacing: -.03em; line-height: 1; }
  .ring-large .lbl { font-size: .65rem; opacity: .85; text-transform: uppercase; letter-spacing: .14em; margin-top: .3rem; font-weight: 700; }

  .hero-text { flex: 1; min-width: 240px; }
  .hero-text h2 { font-size: 1.9rem; font-weight: 800; letter-spacing: -.025em; margin-bottom: .5rem; line-height: 1.15; }
  .hero-text p { font-size: 1rem; opacity: .9; line-height: 1.55; max-width: 520px; }

  .hero-actions { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .hero-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .75rem 1.35rem; border-radius: 12px;
    font-weight: 700; font-size: .9rem;
    border: none; cursor: pointer; text-decoration: none;
    transition: all .15s;
  }
  .hero-btn.white { background: #fff; color: #4f46e5; box-shadow: 0 8px 20px rgba(0,0,0,.15); }
  .hero-btn.white:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0,0,0,.22); }
  .hero-btn.ghost { background: rgba(255,255,255,.15); color: #fff; border: 1px solid rgba(255,255,255,.3); backdrop-filter: blur(10px); }
  .hero-btn.ghost:hover { background: rgba(255,255,255,.25); }

  /* ===== STATS ===== */
  .stat-grid-premium {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .stat-tile {
    position: relative;
    background: #fff;
    border-radius: 18px;
    padding: 1.35rem 1.4rem;
    border: 1px solid #eef0f6;
    box-shadow: 0 4px 16px rgba(15,23,42,.04);
    transition: all .2s;
    overflow: hidden;
    isolation: isolate;
  }
  .stat-tile::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--tile-color-1), var(--tile-color-2));
  }
  .stat-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(15,23,42,.1);
    border-color: transparent;
  }
  .stat-tile .tile-icon {
    width: 42px; height: 42px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem;
    margin-bottom: .85rem;
    background: linear-gradient(135deg, var(--tile-color-1), var(--tile-color-2));
    box-shadow: 0 6px 16px rgba(99,102,241,.25);
  }
  .stat-tile .tile-num {
    font-size: 1.85rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -.03em;
    line-height: 1;
    margin-bottom: .3rem;
  }
  .stat-tile .tile-lbl {
    font-size: .78rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  .stat-tile .tile-sub {
    font-size: .78rem;
    color: #94a3b8;
    margin-top: .4rem;
  }

  .tile-blue    { --tile-color-1: #3b82f6; --tile-color-2: #6366f1; }
  .tile-violet  { --tile-color-1: #8b5cf6; --tile-color-2: #6366f1; }
  .tile-pink    { --tile-color-1: #ec4899; --tile-color-2: #f43f5e; }
  .tile-orange  { --tile-color-1: #f97316; --tile-color-2: #f59e0b; }
  .tile-emerald { --tile-color-1: #10b981; --tile-color-2: #14b8a6; }
  .tile-cyan    { --tile-color-1: #06b6d4; --tile-color-2: #0ea5e9; }

  /* ===== TWO-COLUMN LAYOUT ===== */
  .two-col {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media (max-width: 1000px) {
    .two-col { grid-template-columns: 1fr; }
  }

  /* ===== CONTINUE CARD ===== */
  .continue-card {
    background: #fff;
    border-radius: 22px;
    padding: 1.75rem 2rem;
    border: 1px solid #eef0f6;
    box-shadow: 0 6px 24px rgba(15,23,42,.05);
    margin-bottom: 1.5rem;
    display: flex; gap: 1.75rem; align-items: center; flex-wrap: wrap;
  }
  .continue-cover {
    width: 90px; height: 90px;
    border-radius: 20px;
    background: linear-gradient(135deg, #6366f1, #ec4899);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.4rem; flex-shrink: 0;
    box-shadow: 0 12px 28px rgba(99,102,241,.35);
  }
  .continue-body { flex: 1; min-width: 200px; }
  .continue-body h3 { font-size: 1.15rem; font-weight: 800; color: #0f172a; letter-spacing: -.015em; margin-bottom: .35rem; }
  .continue-body p { font-size: .85rem; color: #64748b; margin-bottom: .85rem; }

  .progress-pill {
    height: 8px;
    background: #eef0f6;
    border-radius: 100px;
    overflow: hidden;
    margin-bottom: .5rem;
  }
  .progress-pill > div {
    height: 100%;
    border-radius: 100px;
    background: linear-gradient(90deg, #6366f1, #ec4899);
    transition: width .5s ease;
  }

  /* ===== SECTIONS ===== */
  .panel {
    background: #fff;
    border-radius: 22px;
    padding: 1.5rem 1.75rem;
    border: 1px solid #eef0f6;
    box-shadow: 0 4px 16px rgba(15,23,42,.04);
    margin-bottom: 1.5rem;
  }
  .panel-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1.1rem;
  }
  .panel-head h3 {
    font-size: 1.02rem; font-weight: 800; color: #0f172a;
    letter-spacing: -.01em;
    display: flex; align-items: center; gap: .55rem;
  }
  .panel-head h3 .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #ec4899);
    box-shadow: 0 0 10px rgba(99,102,241,.5);
  }
  .panel-head a { font-size: .82rem; color: #6366f1; text-decoration: none; font-weight: 700; }
  .panel-head a:hover { text-decoration: underline; }

  /* ===== DEADLINES ===== */
  .deadline-item {
    display: flex; gap: .85rem; align-items: center;
    padding: .85rem 1rem;
    border-radius: 12px;
    background: #fafbff;
    border-left: 3px solid #cbd5e1;
    margin-bottom: .55rem;
    transition: all .15s;
    text-decoration: none; color: inherit;
  }
  .deadline-item:hover { background: #eef2ff; transform: translateX(4px); }
  .deadline-item.urgent { border-left-color: #ef4444; background: #fef2f2; }
  .deadline-item.soon   { border-left-color: #f59e0b; background: #fffbeb; }
  .deadline-item.safe   { border-left-color: #10b981; background: #f0fdf4; }
  .deadline-date {
    width: 50px; height: 50px;
    background: #fff; border-radius: 12px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    font-weight: 800; flex-shrink: 0;
    box-shadow: 0 3px 10px rgba(15,23,42,.06);
  }
  .deadline-date .d { font-size: 1.15rem; line-height: 1; color: #0f172a; }
  .deadline-date .m { font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; color: #64748b; margin-top: .15rem; }
  .deadline-info { flex: 1; min-width: 0; }
  .deadline-info .t { font-weight: 700; color: #0f172a; font-size: .92rem; }
  .deadline-info .c { font-size: .76rem; color: #64748b; margin-top: .15rem; }

  /* ===== ACTIVITY ===== */
  .activity-item {
    display: flex; gap: .75rem; padding: .7rem 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: .88rem;
  }
  .activity-item:last-child { border-bottom: none; }
  .activity-icon {
    width: 32px; height: 32px;
    border-radius: 10px;
    background: linear-gradient(135deg, #eef2ff, #e0e7ff);
    display: flex; align-items: center; justify-content: center;
    font-size: .95rem;
    flex-shrink: 0;
  }
  .activity-body { flex: 1; min-width: 0; }
  .activity-body .t { color: #0f172a; font-weight: 600; }
  .activity-body .m { font-size: .75rem; color: #94a3b8; margin-top: .15rem; }

  /* ===== ACHIEVEMENTS ===== */
  .achievement-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: .75rem;
  }
  .achievement {
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
    border: 1px solid #eef0f6;
    border-radius: 14px;
    padding: .85rem .5rem;
    text-align: center;
    transition: all .2s;
    cursor: default;
  }
  .achievement:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 10px 24px rgba(99,102,241,.15);
    border-color: #c7d2fe;
  }
  .achievement .a-icon { font-size: 1.65rem; line-height: 1; margin-bottom: .35rem; }
  .achievement .a-name { font-size: .68rem; font-weight: 800; color: #334155; text-transform: uppercase; letter-spacing: .05em; }

  /* ===== QUOTE ===== */
  .quote-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    border-radius: 22px;
    padding: 1.75rem 2rem;
    color: #fff;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(15,23,42,.25);
  }
  .quote-card::before {
    content: '"'; position: absolute;
    right: 1rem; top: -2rem;
    font-size: 12rem; font-weight: 900;
    color: rgba(255,255,255,.05);
    line-height: 1;
    font-family: Georgia, serif;
  }
  .quote-card .q-text {
    font-size: 1.05rem;
    line-height: 1.55;
    font-weight: 500;
    font-style: italic;
    position: relative;
    z-index: 1;
    margin-bottom: .85rem;
  }
  .quote-card .q-author {
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    font-weight: 700;
    color: #a5b4fc;
  }

  /* ===== COURSE GRID (mini) ===== */
  .mini-course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .mini-course {
    background: #fff;
    border-radius: 16px;
    padding: 1.15rem 1.25rem;
    border: 1px solid #eef0f6;
    box-shadow: 0 3px 12px rgba(15,23,42,.03);
    transition: all .2s;
    text-decoration: none; color: inherit;
    display: block;
    position: relative;
    overflow: hidden;
  }
  .mini-course::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, #6366f1, #ec4899);
  }
  .mini-course:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(15,23,42,.08);
  }
  .mini-course h4 {
    font-size: .95rem; font-weight: 800; color: #0f172a;
    margin-bottom: .5rem; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .mini-course .mc-pct { font-size: 1.5rem; font-weight: 900; color: #4f46e5; letter-spacing: -.03em; }
  .mini-course .mc-sub { font-size: .72rem; color: #94a3b8; margin-top: .2rem; }
  .mini-course .mc-bar { height: 5px; background: #eef0f6; border-radius: 100px; margin-top: .75rem; overflow: hidden; }
  .mini-course .mc-bar > div { height: 100%; background: linear-gradient(90deg, #6366f1, #ec4899); border-radius: 100px; }
</style>

<!-- ============ HERO ============ -->
<div class="dash-hero animate">
  <div class="ring-large">
    <svg width="140" height="140" viewBox="0 0 140 140">
      <circle cx="70" cy="70" r="60" stroke="rgba(255,255,255,.2)" stroke-width="10" fill="none"/>
      <circle cx="70" cy="70" r="60" stroke="#fff" stroke-width="10" fill="none"
              stroke-linecap="round"
              stroke-dasharray="<%= (2 * Math.PI * 60).toFixed(0) %>"
              stroke-dashoffset="<%= ((1 - stats.overallPct / 100) * 2 * Math.PI * 60).toFixed(0) %>"/>
    </svg>
    <div class="ring-inner">
      <div class="pct"><%= stats.overallPct %>%</div>
      <div class="lbl">Overall</div>
    </div>
  </div>

  <div class="hero-text">
    <h2>
      <% if (stats.overallPct === 100) { %>
        🏆 You crushed it! 100% complete.
      <% } else if (stats.overallPct >= 75) { %>
        🚀 Almost there! Keep going.
      <% } else if (stats.overallPct >= 50) { %>
        ⚡ Halfway! Nice pace.
      <% } else if (stats.overallPct > 0) { %>
        🌱 Great start — keep building.
      <% } else { %>
        ✨ Let's start your first lesson!
      <% } %>
    </h2>
    <p>
      <%= stats.completed %> of <%= stats.lessons %> lessons done across <%= stats.courses %> course<%= stats.courses === 1 ? '' : 's' %>.
      <% if (stats.pendingQuizzes > 0) { %>You still have <strong><%= stats.pendingQuizzes %></strong> quiz<%= stats.pendingQuizzes === 1 ? '' : 'zes' %> to take.<% } %>
    </p>

    <div class="hero-actions">
      <% if (continueCourse) { %>
        <a class="hero-btn white" href="/courses/<%= continueCourse.id %>">▶️ Continue learning</a>
      <% } %>
      <a class="hero-btn ghost" href="/student/courses">📚 Browse all</a>
    </div>
  </div>
</div>

<!-- ============ STAT TILES ============ -->
<div class="stat-grid-premium animate">
  <div class="stat-tile tile-blue">
    <div class="tile-icon">📚</div>
    <div class="tile-num"><%= stats.courses %></div>
    <div class="tile-lbl">Courses</div>
    <div class="tile-sub">Enrolled</div>
  </div>
  <div class="stat-tile tile-emerald">
    <div class="tile-icon">✅</div>
    <div class="tile-num"><%= stats.completed %></div>
    <div class="tile-lbl">Lessons</div>
    <div class="tile-sub">Completed</div>
  </div>
  <div class="stat-tile tile-orange">
    <div class="tile-icon">🔥</div>
    <div class="tile-num"><%= stats.streak %></div>
    <div class="tile-lbl">Day Streak</div>
    <div class="tile-sub"><%= stats.streak >= 3 ? 'Keep it up!' : 'Try for 3' %></div>
  </div>
  <div class="stat-tile tile-violet">
    <div class="tile-icon">💎</div>
    <div class="tile-num"><%= stats.points %></div>
    <div class="tile-lbl">Points</div>
    <div class="tile-sub">Earned</div>
  </div>
  <div class="stat-tile tile-pink">
    <div class="tile-icon">📝</div>
    <div class="tile-num"><%= stats.pendingQuizzes %></div>
    <div class="tile-lbl">Quizzes</div>
    <div class="tile-sub"><%= stats.pendingQuizzes === 0 ? 'All done!' : 'To take' %></div>
  </div>
  <div class="stat-tile tile-cyan">
    <div class="tile-icon">🎯</div>
    <div class="tile-num"><%= stats.overallPct %>%</div>
    <div class="tile-lbl">Progress</div>
    <div class="tile-sub">Overall</div>
  </div>
</div>

<!-- ============ CONTINUE LEARNING ============ -->
<% if (continueCourse && continueCourse.total_lessons > 0) {
     const pct = Math.round((continueCourse.done_lessons / continueCourse.total_lessons) * 100);
%>
  <div class="continue-card animate">
    <div class="continue-cover">▶️</div>
    <div class="continue-body">
      <div style="font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#6366f1;margin-bottom:.35rem;">
        Continue where you left off
      </div>
      <h3><%= continueCourse.title %></h3>
      <p><%= continueCourse.done_lessons %> of <%= continueCourse.total_lessons %> lessons · <%= pct %>% complete</p>
      <div class="progress-pill"><div style="width:<%= pct %>%"></div></div>
    </div>
    <a class="hero-btn" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;box-shadow:0 10px 24px rgba(99,102,241,.35);" href="/courses/<%= continueCourse.id %>">
      Resume →
    </a>
  </div>
<% } %>

<!-- ============ TWO COLUMN ============ -->
<div class="two-col animate">
  <!-- LEFT: Deadlines + Courses -->
  <div>
    <div class="panel">
      <div class="panel-head">
        <h3><span class="dot"></span> Upcoming deadlines</h3>
        <a href="/calendar">View calendar →</a>
      </div>

      <% if (deadlines.length === 0) { %>
        <div class="empty" style="padding:1.5rem;">🎉 No upcoming deadlines. You're all caught up!</div>
      <% } else { %>
        <% deadlines.forEach(d => {
             const when = new Date(d.when);
             const hours = (when - new Date()) / 3600000;
             const cls = hours < 24 ? 'urgent' : hours < 72 ? 'soon' : 'safe';
        %>
          <a class="deadline-item <%= cls %>" href="<%= d.kind === 'assignment' ? '/student/assignments/' + d.id : '/student/quiz/' + d.id %>">
            <div class="deadline-date">
              <div class="d"><%= when.getDate() %></div>
              <div class="m"><%= when.toLocaleString('en', { month: 'short' }) %></div>
            </div>
            <div class="deadline-info">
              <div class="t"><%= d.kind === 'quiz' ? '📝' : '📋' %> <%= d.title %></div>
              <div class="c"><%= d.course %> · <%= when.toLocaleString([], { hour: '2-digit', minute: '2-digit' }) %></div>
            </div>
          </a>
        <% }) %>
      <% } %>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3><span class="dot"></span> Your courses</h3>
        <a href="/student/courses">See all →</a>
      </div>

      <% if (courses.length === 0) { %>
        <div class="empty">📭 You're not enrolled in any course yet.</div>
      <% } else { %>
        <div class="mini-course-grid">
          <% courses.slice(0, 4).forEach(c => {
               const pct = c.total_lessons ? Math.round((c.done_lessons / c.total_lessons) * 100) : 0;
          %>
            <a class="mini-course" href="/courses/<%= c.id %>">
              <h4><%= c.title %></h4>
              <div class="mc-pct"><%= pct %>%</div>
              <div class="mc-sub"><%= c.done_lessons %>/<%= c.total_lessons %> lessons</div>
              <div class="mc-bar"><div style="width:<%= pct %>%"></div></div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- RIGHT: Achievements + Activity + Quote -->
  <div>
    <div class="panel">
      <div class="panel-head">
        <h3><span class="dot"></span> Achievements</h3>
      </div>
      <% if (achievements.length === 0) { %>
        <div class="empty" style="padding:1rem;font-size:.85rem;">Complete lessons to unlock badges 🏅</div>
      <% } else { %>
        <div class="achievement-grid">
          <% achievements.forEach(a => { %>
            <div class="achievement" title="<%= a.desc %>">
              <div class="a-icon"><%= a.icon %></div>
              <div class="a-name"><%= a.name %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3><span class="dot"></span> Recent activity</h3>
      </div>
      <% if (recentActivity.length === 0) { %>
        <div class="empty" style="padding:1rem;font-size:.85rem;">No activity yet.</div>
      <% } else { %>
        <% recentActivity.forEach(a => { %>
          <div class="activity-item">
            <div class="activity-icon"><%= a.kind === 'quiz' ? '📝' : '✅' %></div>
            <div class="activity-body">
              <div class="t"><%= a.title %></div>
              <div class="m"><%= a.course %> · <%= new Date(a.at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="quote-card">
      <div class="q-text"><%= quote.text %></div>
      <div class="q-author">— <%= quote.author %></div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>