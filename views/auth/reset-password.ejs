<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New password · LuxMind</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, 'Inter', sans-serif; }
    html, body { height: 100%; }
    body {
      background: radial-gradient(circle at 30% 20%, #4c1d95 0%, #0f172a 70%);
      display: flex; align-items: center; justify-content: center;
      padding: 2rem; color: #fff;
    }
    .box {
      background: #fff; color: #0f172a;
      width: 100%; max-width: 440px;
      border-radius: 24px;
      padding: 2.75rem 2.5rem;
      box-shadow: 0 30px 80px rgba(0,0,0,.5);
      animation: pop .4s cubic-bezier(.2,.8,.3,1);
    }
    @keyframes pop { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

    .logo {
      width: 56px; height: 56px;
      border-radius: 16px;
      background: linear-gradient(135deg, #8b5cf6, #ec4899);
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; font-size: 1.6rem; color: #fff;
      margin: 0 auto 1.25rem;
      box-shadow: 0 12px 30px rgba(139,92,246,.4);
    }
    h1 { font-size: 1.55rem; font-weight: 800; text-align: center; letter-spacing: -.025em; margin-bottom: .5rem; }
    .sub { text-align: center; color: #64748b; font-size: .92rem; line-height: 1.55; margin-bottom: 2rem; }

    .field { margin-bottom: 1.15rem; }
    .field label { display: block; font-size: .85rem; font-weight: 600; color: #334155; margin-bottom: .4rem; }
    .field input {
      width: 100%; padding: 13px 16px;
      border: 1.5px solid #e2e8f0; border-radius: 12px;
      font-size: .95rem; background: #f8fafc; color: #0f172a;
      font-family: inherit; transition: all .15s;
    }
    .field input:focus { outline: none; border-color: #8b5cf6; background: #fff; box-shadow: 0 0 0 4px rgba(139,92,246,.12); }

    .btn {
      width: 100%; padding: 14px;
      background: linear-gradient(135deg, #8b5cf6, #ec4899);
      color: #fff; border: none; border-radius: 12px;
      font-size: 1rem; font-weight: 700; cursor: pointer;
      box-shadow: 0 10px 24px rgba(139,92,246,.4);
      transition: all .15s;
      margin-top: .5rem;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn:disabled { opacity: .6; cursor: wait; transform: none; }

    .flash {
      padding: 12px 16px; border-radius: 12px; margin-bottom: 1.25rem;
      font-size: .88rem; font-weight: 500;
    }
    .flash.error { background: #fef2f2; color: #991b1b; border-left: 4px solid #ef4444; }
    .flash.success { background: #ecfdf5; color: #065f46; border-left: 4px solid #10b981; }

    .back { display: block; text-align: center; margin-top: 1.5rem; font-size: .88rem; color: #8b5cf6; text-decoration: none; font-weight: 600; }
    .back:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="box">
    <div class="logo">🔒</div>
    <h1>Create new password</h1>
    <p class="sub">Choose a strong password for your LuxMind account.</p>

    <div id="errBox" class="flash error" style="display:none;"></div>
    <div id="okBox" class="flash success" style="display:none;"></div>

    <form id="resetForm">
      <div class="field">
        <label for="password">New password</label>
        <input type="password" id="password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
      </div>

      <div class="field">
        <label for="password2">Confirm password</label>
        <input type="password" id="password2" placeholder="Re-enter password" required minlength="6" autocomplete="new-password">
      </div>

      <button type="submit" class="btn" id="submitBtn">Save new password</button>
    </form>

    <a href="/login" class="back">← Back to sign in</a>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, confirmPasswordReset, verifyPasswordResetCode } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCv4qQpAm4yDr68i-Z6ftIoYzK_2vTJhJc",
      authDomain: "luxmind-web.firebaseapp.com",
      projectId: "luxmind-web",
      storageBucket: "luxmind-web.firebasestorage.app",
      messagingSenderId: "626044917535",
      appId: "1:626044917535:web:d0dfe8389022f4349ac22a"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    const oobCode = '<%= oobCode %>';

    const form = document.getElementById('resetForm');
    const btn = document.getElementById('submitBtn');
    const errBox = document.getElementById('errBox');
    const okBox = document.getElementById('okBox');

    // Validate the code on page load
    (async () => {
      if (!oobCode) {
        errBox.textContent = '⚠️ Missing reset code. Open the link from your email again.';
        errBox.style.display = 'block';
        form.style.display = 'none';
        return;
      }
      try {
        await verifyPasswordResetCode(auth, oobCode);
      } catch (err) {
        errBox.textContent = '⚠️ This reset link is invalid or expired. Request a new one.';
        errBox.style.display = 'block';
        form.style.display = 'none';
      }
    })();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = document.getElementById('password').value;
      const pass2 = document.getElementById('password2').value;

      errBox.style.display = 'none';
      okBox.style.display = 'none';

      if (pass !== pass2) {
        errBox.textContent = '⚠️ Passwords do not match.';
        errBox.style.display = 'block';
        return;
      }
      if (pass.length < 6) {
        errBox.textContent = '⚠️ Password must be at least 6 characters.';
        errBox.style.display = 'block';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Saving...';

      try {
        await confirmPasswordReset(auth, oobCode, pass);
        okBox.textContent = '✅ Password changed! Redirecting to sign in...';
        okBox.style.display = 'block';
        setTimeout(() => { window.location.href = '/login'; }, 1800);
      } catch (err) {
        errBox.textContent = '⚠️ ' + (err.message || 'Could not reset password.');
        errBox.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Save new password';
      }
    });
  </script>
</body>
</html>