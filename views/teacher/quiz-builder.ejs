<%- include('../partials/head', { 
  title: 'New Quiz',
  heading: 'Create Quiz',
  subtitle: course.title
}) %>

<form method="POST" action="/teacher/quiz/new/<%= course.id %>" id="quizForm">
  <div class="card animate" style="margin-bottom:1.5rem;">
    <div style="font-weight:700;color:#0f172a;margin-bottom:1rem;">Quiz Settings</div>

    <label style="display:block;font-weight:600;color:#334155;margin-bottom:.4rem;">Quiz title</label>
    <input name="title" required placeholder="e.g. HTML Basics Quiz"
      style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;margin-bottom:1.2rem;background:#f8fafc;">

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
      <div>
        <label style="display:block;font-weight:600;color:#334155;margin-bottom:.4rem;">Grade release time</label>
        <input type="datetime-local" name="release_at" required
          style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;background:#f8fafc;">
      </div>
      <div>
        <label style="display:block;font-weight:600;color:#334155;margin-bottom:.4rem;">Duration (minutes)</label>
        <input type="number" name="duration_min" value="15" min="1"
          style="width:100%;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:1rem;background:#f8fafc;">
      </div>
    </div>
  </div>

  <div class="section-head"><h2><span class="dot"></span> Questions</h2></div>
  <div id="questions"></div>

  <button type="button" onclick="addQuestion()" class="btn outline" style="margin-bottom:1.5rem;">+ Add Question</button>

  <input type="hidden" name="questions" id="questionsJSON">

  <div class="action-bar">
    <a class="btn outline" href="/teacher/quizzes">← Cancel</a>
    <button class="btn" type="submit" style="padding:.85rem 1.8rem;">✓ Create Quiz</button>
  </div>
</form>

<script>
let qCount = 0;

function addQuestion() {
  qCount++;
  const div = document.createElement('div');
  div.className = 'card qbox animate';
  div.style.marginBottom = '1rem';
  div.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
      <div style="font-weight:700;color:#0f172a;">Question #${qCount}</div>
      <button type="button" onclick="this.closest('.qbox').remove()" style="background:transparent;border:none;color:#ef4444;font-weight:700;cursor:pointer;">✕ Remove</button>
    </div>

    <label style="display:block;font-weight:600;color:#334155;margin-bottom:.4rem;">Question type</label>
    <select class="qtype" onchange="changeType(this)"
      style="width:100%;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;margin-bottom:.8rem;">
      <option value="mc">Multiple Choice</option>
      <option value="tf">True / False</option>
      <option value="short">Short Answer</option>
      <option value="essay">Essay (manual grade)</option>
    </select>

    <input class="qtext" placeholder="Question text" required
      style="width:100%;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.95rem;margin-bottom:.8rem;background:#f8fafc;">

    <div class="type-fields"></div>

    <div style="margin-top:.8rem;">
      <label style="font-size:.82rem;font-weight:600;color:#334155;">Points</label>
      <input type="number" class="qpoints" value="1" min="1"
        style="width:100%;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
    </div>
  `;
  document.getElementById('questions').appendChild(div);
  changeType(div.querySelector('.qtype'));
}

function changeType(select) {
  const box = select.closest('.qbox');
  const fields = box.querySelector('.type-fields');
  const type = select.value;

  if (type === 'mc') {
    fields.innerHTML = `
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem;">
        <input class="qa" placeholder="Option A" required style="padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
        <input class="qb" placeholder="Option B" required style="padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
        <input class="qc" placeholder="Option C" required style="padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
        <input class="qd" placeholder="Option D" required style="padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
      </div>
      <div style="margin-top:.6rem;">
        <label style="font-size:.82rem;font-weight:600;color:#334155;">Correct answer</label>
        <select class="qcorrect" style="width:100%;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
          <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
        </select>
      </div>
    `;
  } else if (type === 'tf') {
    fields.innerHTML = `
      <div>
        <label style="font-size:.82rem;font-weight:600;color:#334155;">Correct answer</label>
        <select class="qcorrect" style="width:100%;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
          <option value="true">True</option>
          <option value="false">False</option>
        </select>
      </div>
    `;
  } else if (type === 'short') {
    fields.innerHTML = `
      <div>
        <label style="font-size:.82rem;font-weight:600;color:#334155;">Correct answer (case-insensitive)</label>
        <input class="qcorrect" placeholder="Exact answer" required
          style="width:100%;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;">
      </div>
    `;
  } else {
    fields.innerHTML = `
      <div style="padding:.7rem 1rem;background:#fffbeb;border-left:3px solid #f59e0b;border-radius:8px;font-size:.85rem;color:#78350f;">
        📝 Essay answers will be graded manually by you in the Grading Queue.
      </div>
    `;
  }
}

document.getElementById('quizForm').addEventListener('submit', () => {
  const qs = [...document.querySelectorAll('.qbox')].map(box => {
    const type = box.querySelector('.qtype').value;
    const q = {
      type: type,
      text: box.querySelector('.qtext').value,
      points: box.querySelector('.qpoints').value,
    };
    if (type === 'mc') {
      q.a = box.querySelector('.qa').value;
      q.b = box.querySelector('.qb').value;
      q.c = box.querySelector('.qc').value;
      q.d = box.querySelector('.qd').value;
      q.correct = box.querySelector('.qcorrect').value;
    } else if (type === 'tf') {
      q.correct = box.querySelector('.qcorrect').value;
    } else if (type === 'short') {
      q.correct = box.querySelector('.qcorrect').value;
    }
    return q;
  });
  document.getElementById('questionsJSON').value = JSON.stringify(qs);
});

addQuestion();
</script>

<%- include('../partials/foot') %>