<%- include('../partials/head', {
  title: 'Import Result',
  heading: 'Import Complete',
  subtitle: 'Summary of the CSV upload.'
}) %>

<div class="stat-grid animate" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-bottom:1.5rem;">
  <div class="stat emerald">
    <div class="stat-icon">✅</div>
    <div class="num"><%= results.created.length %></div>
    <div class="lbl">Created</div>
  </div>
  <div class="stat orange">
    <div class="stat-icon">⚠️</div>
    <div class="num"><%= results.skipped.length %></div>
    <div class="lbl">Skipped (existing)</div>
  </div>
  <div class="stat pink">
    <div class="stat-icon">❌</div>
    <div class="num"><%= results.errors.length %></div>
    <div class="lbl">Errors</div>
  </div>
</div>

<% if (course) { %>
  <div class="card animate" style="margin-bottom:1.5rem;border-left:4px solid #0891b2;">
    📘 Enrolled new students in: <strong><%= course.title %></strong>
  </div>
<% } %>

<% if (results.created.length > 0) { %>
  <div class="section-head"><h2><span class="dot"></span> ✅ Created Students</h2></div>
  <div class="table-wrap animate" style="max-height:320px;overflow-y:auto;margin-bottom:1.5rem;">
    <table>
      <thead><tr><th>Email</th></tr></thead>
      <tbody>
        <% results.created.forEach(e => { %>
          <tr><td><%= e %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (results.skipped.length > 0) { %>
  <div class="section-head"><h2><span class="dot"></span> ⚠️ Skipped (already exist)</h2></div>
  <div class="table-wrap animate" style="max-height:200px;overflow-y:auto;margin-bottom:1.5rem;">
    <table>
      <thead><tr><th>Email</th></tr></thead>
      <tbody>
        <% results.skipped.forEach(e => { %>
          <tr><td><%= e %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (results.errors.length > 0) { %>
  <div class="section-head"><h2><span class="dot"></span> ❌ Errors</h2></div>
  <div class="table-wrap animate" style="margin-bottom:1.5rem;">
    <table>
      <thead><tr><th>Problem</th></tr></thead>
      <tbody>
        <% results.errors.forEach(e => { %>
          <tr><td style="color:#b91c1c;"><%= e %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<div style="display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.5rem;">
  <a class="btn" href="/teacher/students">📚 View All Students</a>
  <a class="btn outline" href="/teacher/import-students">↻ Import More</a>
</div>

<%- include('../partials/foot') %>