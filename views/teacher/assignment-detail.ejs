<%- include('../partials/head', { 
  title: assignment.title,
  heading: assignment.title,
  subtitle: assignment.course_title
}) %>

<div class="card animate" style="margin-bottom:1.5rem;">
  <div class="muted" style="font-size:.82rem;margin-bottom:.5rem;">
    📅 <%= assignment.deadline ? new Date(assignment.deadline).toLocaleString() : 'No deadline' %>
    · 💯 <%= assignment.max_points %> pts
  </div>
  <% if (assignment.description) { %>
    <p style="color:#334155;line-height:1.6;"><%= assignment.description %></p>
  <% } %>
</div>

<div class="section-head">
  <h2><span class="dot"></span> Submissions (<%= submissions.length %>)</h2>
  <a class="btn outline" href="/teacher/assignments">← Back</a>
</div>

<% if (submissions.length === 0) { %>
  <div class="empty">📭 No submissions yet.</div>
<% } else { %>
  <% submissions.forEach(s => { %>
    <div class="card animate" style="margin-bottom:1rem;">
      <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:240px;">
          <div style="font-weight:700;color:#0f172a;"><%= s.student_name || s.student_username %></div>
          <div class="muted" style="font-size:.78rem;">
            Submitted <%= new Date(s.submitted_at).toLocaleString() %>
            <% if (s.score !== null) { %>· <span class="badge ok">Graded</span><% } else { %>· <span class="badge warn">Pending</span><% } %>
          </div>

          <% if (s.text_content) { %>
            <p style="margin-top:.75rem;color:#334155;background:#f8fafc;padding:.85rem 1rem;border-radius:10px;border-left:3px solid #6366f1;">
              <%= s.text_content %>
            </p>
          <% } %>

          <% if (s.file_path) { %>
            <a class="btn outline" href="<%= s.file_path %>" download style="margin-top:.75rem;font-size:.82rem;">⬇️ <%= s.file_name %></a>
          <% } %>
        </div>

        <form method="POST" action="/teacher/submissions/<%= s.id %>/grade"
          style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:flex-start;">
          <input type="number" name="score" min="0" max="<%= assignment.max_points %>"
            value="<%= s.score ?? '' %>" placeholder="Score" required
            style="width:90px;padding:.6rem .8rem;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;font-size:.9rem;">
          <input type="text" name="feedback" value="<%= s.feedback || '' %>" placeholder="Feedback"
            style="flex:1;min-width:180px;padding:.6rem .8rem;border:1.5px solid #e2e8f0;border-radius:10px;background:#f8fafc;font-size:.9rem;">
          <button class="btn" type="submit" style="padding:.6rem 1.2rem;font-size:.85rem;">💾 Save</button>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>

<% if (notSubmitted.length > 0) { %>
  <div class="section-head" style="margin-top:2rem;">
    <h2><span class="dot"></span> Not Submitted Yet</h2>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Student</th><th>Username</th></tr></thead>
      <tbody>
        <% notSubmitted.forEach(s => { %>
          <tr>
            <td><%= s.full_name || s.username %></td>
            <td class="muted">@<%= s.username %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/foot') %>