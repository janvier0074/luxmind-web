<%- include('../partials/head', {
  title: 'Students',
  heading: 'Student Registry',
  subtitle: 'Manage all students in the school.'
}) %>

<div class="stat-grid animate" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:1.5rem;">
  <div class="stat blue">
    <div class="stat-icon">👥</div>
    <div class="num"><%= totals.all %></div>
    <div class="lbl">Total Students</div>
  </div>
  <div class="stat emerald">
    <div class="stat-icon">✅</div>
    <div class="num"><%= totals.active %></div>
    <div class="lbl">Active</div>
  </div>
  <div class="stat pink">
    <div class="stat-icon">⏸️</div>
    <div class="num"><%= totals.inactive %></div>
    <div class="lbl">Inactive</div>
  </div>
</div>

<div class="card animate" style="margin-bottom:1.5rem;">
  <form method="GET" action="/admin/students" style="display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;">
    <input name="q" value="<%= q %>" placeholder="Search name, username, email, admission #"
      style="flex:1;min-width:220px;padding:.7rem 1rem;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.92rem;">
    <select name="class" style="padding:.7rem 1rem;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.92rem;">
      <option value="">All classes</option>
      <% classList.forEach(c => { %>
        <option value="<%= c.class_level %>" <%= classFilter === c.class_level ? 'selected' : '' %>><%= c.class_level %></option>
      <% }) %>
    </select>
    <button class="btn" type="submit">Search</button>
    <a class="btn" href="/admin/students/new" style="background:linear-gradient(135deg,#10b981,#14b8a6);">+ Add Student</a>
  </form>
</div>

<% if (students.length === 0) { %>
  <div class="empty">📭 No students found. <a href="/admin/students/new">Add the first one →</a></div>
<% } else { %>
  <div class="card animate" style="padding:0;overflow:hidden;">
    <table style="width:100%;border-collapse:collapse;">
      <thead style="background:#f8fafc;border-bottom:1px solid #eef0f6;">
        <tr>
          <th style="text-align:left;padding:1rem;">Student</th>
          <th style="text-align:left;padding:1rem;">Admission #</th>
          <th style="text-align:left;padding:1rem;">Class</th>
          <th style="text-align:left;padding:1rem;">Guardian</th>
          <th style="text-align:left;padding:1rem;">Status</th>
          <th style="text-align:right;padding:1rem;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach(s => { %>
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:1rem;">
              <div style="font-weight:700;color:#0f172a;"><%= s.full_name || s.username %></div>
              <div class="muted" style="font-size:.78rem;">@<%= s.username %></div>
            </td>
            <td style="padding:1rem;color:#64748b;"><%= s.admission_number || '—' %></td>
            <td style="padding:1rem;">
              <% if (s.class_level) { %>
                <span class="badge info"><%= s.class_level %></span>
              <% } else { %>
                <span class="muted">—</span>
              <% } %>
            </td>
            <td style="padding:1rem;">
              <% if (s.guardian_name) { %>
                <div style="color:#334155;"><%= s.guardian_name %></div>
                <div class="muted" style="font-size:.78rem;"><%= s.guardian_phone || '' %></div>
              <% } else { %>
                <span class="muted">—</span>
              <% } %>
            </td>
            <td style="padding:1rem;">
              <% if (s.status === 'active' || s.is_active) { %>
                <span class="badge ok">Active</span>
              <% } else { %>
                <span class="badge err">Inactive</span>
              <% } %>
            </td>
            <td style="padding:1rem;text-align:right;white-space:nowrap;">
              <a class="btn outline" href="/admin/students/<%= s.id %>" style="padding:.4rem .8rem;font-size:.8rem;">View</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/foot') %>